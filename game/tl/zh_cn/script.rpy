# TODO: Translation updated at 2025-11-17 20:08

# game/script.rpy:242
translate zh_cn start_eb4356e0:

    # "車窓から降りこむ雨が\n腕を濡らしていた。"
    "车窗飘洒的雨丝，濡湿了我的手臂。"

# game/script.rpy:244
translate zh_cn start_0bd6f2f6:

    # "汽車は、無人のてんまさわ駅を過ぎた。\n終点のとうかんもりは、もうすぐだ。"
    "列车驶过了无人值守的天满泽站。\n离终点稻荷森站不远了。"

# game/script.rpy:250
translate zh_cn start_d831193a:

    # "腕をくんで天井へ向け、\n硬くなった体をほぐす。"
    "我抱着胳膊望向车顶，\n试图舒展僵直的躯体。"

# game/script.rpy:252
translate zh_cn start_8c571cb7:

    # "やがて、いつものように\nべつだん車内放送もないまま、\n列車はひっそりとホームにすべりこんだ。"
    "不多时，列车静静滑入站台，\n如往常一般，没有响起任何车内广播。"

# game/script.rpy:256
translate zh_cn start_11d65ba5:

    # "降客が、まばらに改札口へ向かう。"
    "乘客们三三两两下车，\n稀稀拉拉地走向检票口。"

# game/script.rpy:258
translate zh_cn start_d31de8da:

    # "ディーゼル車の低い音がしずまると、\n木造の駅舎は、雨滴の音に包まれた。"
    "柴油发动机的低鸣渐次沉静，\n木造的站舍被雨滴声温柔包裹。"

# game/script.rpy:260
translate zh_cn start_321146c8:

    # "漠とした、けだるさを払うあいだ、\n僕は構内に立ち、\nなにげなく周囲を見渡す。"
    "我立在站内，漫然环顾四周，\n试图挥散心中那份莫名的慵倦。"

# game/script.rpy:262
translate zh_cn start_ab5b1289:

    # "ただよう濃密な雨霧が、\n枯尾沼と駅舎との境界を\nあやうくさせる。"
    "氤氲的雨雾，\n将枯尾沼与站舍的边界\n晕染得模糊而暧昧。"

# game/script.rpy:264
translate zh_cn start_c3e243b3:

    # "夏の日でさえ、この土地は、\n晴れ間をあまり見せてくれない。"
    "即便时值盛夏，\n这片土地\n也难得展露晴空。"

# game/script.rpy:266
translate zh_cn start_e86c5071:

    # "木造の渡り階段が渡された\nホームに目を移す。"
    "我又望向那座\n架着木造渡梯的站台。"

# game/script.rpy:268
translate zh_cn start_5a3aa56b:

    # "あちら側はもう、使われなくなって\nずいぶん経つはずだ。"
    "对侧那月台，\n想来早已废弃多时了。"

# game/script.rpy:270
translate zh_cn start_a690e94f:

    # "幼いころに、\n貨物列車が停まっていたのを\n見たきり。"
    "在我还是小孩子时，\n就有货运列车\n在那里长期搁置不动了。"

# game/script.rpy:272
translate zh_cn start_790d188e:

    # "駅舎そのものは手入れされて、\n今でも整然と保たれている。"
    "车站倒是修缮得宜，\n现如今也依然整洁。"

# game/script.rpy:274
translate zh_cn start_4e96d63f:

    # "ただ鉄路だけが、赤錆を浮かせ、\n山あいの鉱山跡へと消えていた。"
    "唯有铁轨浮着赤锈，\n向着山谷间的矿山遗迹\n蜿蜒隐没。"

# game/script.rpy:279
translate zh_cn start_a0bafcda:

    # j "兄さん。"
    j "哥哥。"

# game/script.rpy:281
translate zh_cn start_4f00cf40:

    # "景観へ向けられていた意識が\n引き戻された。"
    "沉浸在风景中的意识，\n被这一声轻轻唤回。"

# game/script.rpy:283
translate zh_cn start_e5bab0b7:

    # i "───樹里。"
    i "———树里。"

# game/script.rpy:285
translate zh_cn start_c36c15d6:

    # j "ン？"
    j "嗯？"

# game/script.rpy:287
translate zh_cn start_6703b9a3:

    # j "なあに、兄さん。"
    j "怎么了，哥哥？"

# game/script.rpy:289
translate zh_cn start_1a24d5cf:

    # "樹里。\n僕の妹。"
    "树里，\n我的妹妹。"

# game/script.rpy:291
translate zh_cn start_ef1d1353:

    # "小首をかしげた少女は、\n僕の横に立ち、\n視線の先を追う。"
    "少女微歪着头，\n站到我身旁，\n循着我的视线望去——"

# game/script.rpy:296
translate zh_cn start_6d68379c:

    # j "……あのホームも、線路も、\nほんとはもう、要らないんだよね。"
    j "……那个站台，还有铁轨，\n其实早就没用处了吧。"

# game/script.rpy:298
translate zh_cn start_0386dc64:

    # i "…………"
    i "…………"

# game/script.rpy:302
translate zh_cn start_6783f042:

    # j "でもなんだか、こうして\nずっと待ち続けていると……"
    j "可不知怎的，总觉得\n若是这样一直等下去的话……"

# game/script.rpy:304
translate zh_cn start_5d6c13f7:

    # j "向こうから、昔の列車が、\nガタゴト、やってくるかも。"
    j "或许会从过去驶来的列车，\n哐当哐当地，从对面出现呢。"

# game/script.rpy:308
translate zh_cn start_0ba9399f:

    # "過去からの列車。"
    "从过去驶来的列车啊……"

# game/script.rpy:310
translate zh_cn start_337d1c39:

    # "本当に乗りたいと願うなら、\nやってくるのだろうか。"
    "若真心期盼搭乘，\n它是否真会为我而来呢。"

# game/script.rpy:312
translate zh_cn start_d8e765e2:

    # i "迎えに？"
    i "你是来接我的吗？"

# game/script.rpy:317
translate zh_cn start_0461bb6b:

    # j "あ、うん。\nきっと、そろそろかなって。"
    j "啊，嗯。\n想着哥哥差不多该到了。"

# game/script.rpy:319
translate zh_cn start_455e5b60:

    # i "……めずらしい。"
    i "……亏你有心了。"

# game/script.rpy:324
translate zh_cn start_18e1d69d:

    # j "あ、ひどーい。"
    j "啊，好过分诶！"

# game/script.rpy:326
translate zh_cn start_28a8be90:

    # j "兄さん、\n傘持ってないでしょう。"
    j "哥哥，\n你没带伞对吧？"

# game/script.rpy:328
translate zh_cn start_a1715b90:

    # "素直にうなずく。"
    "我老老实实点了头。"

# game/script.rpy:333
translate zh_cn start_d5e1a53d:

    # j "ホラやっぱり。\nきっとね、そうだと思ったの。"
    j "看吧，果然，\n跟我想的一样。"

# game/script.rpy:335
translate zh_cn start_e897697b:

    # "いかにも得意そうな樹里の手には\n濡れた女物の傘が、一つあるだけだった。"
    "然而一脸得意的树里手里，\n只有一把湿漉漉的、\n女孩子才会用的小伞。"

# game/script.rpy:337
translate zh_cn start_f000ff6a:

    # i "……で、僕の傘は？"
    i "………那，我的伞呢？"

# game/script.rpy:339
translate zh_cn start_d6b83467:

    # j "それが忘れちゃったの。\nあはっ。"
    j "嘿嘿，忘记了呢。\n啊哈哈。"

# game/script.rpy:341
translate zh_cn start_4fd2142d:

    # "得意げなまま、樹里は言ってのける。"
    "树里依旧一脸得意地说着。"

# game/script.rpy:343
translate zh_cn start_5b957b8b:

    # i "……"
    i "……"

# game/script.rpy:345
translate zh_cn start_ef585feb:

    # j "あ、でも、\n潤ちゃんが持ってるよ。たぶん。"
    j "啊，不过，\n润酱应该带了，大概。"

# game/script.rpy:347
translate zh_cn start_9406d0c2:

    # i "……誰だい？"
    i "……谁？"

# game/script.rpy:349
translate zh_cn start_d5bfb561:

    # j "えー？　潤ちゃんは潤ちゃんだよ。\n兄さん、おぼえてないの？"
    j "欸？　润酱就是润酱啊。\n哥哥，你不记得润酱了？"

# game/script.rpy:351
translate zh_cn start_6632fc6f:

    # "樹里の学校の友人だったろうか。"
    "是树里学校的朋友吗……"

# game/script.rpy:356
translate zh_cn start_16cd9605:

    # "でも、家に誰かを\n連れてきたことなんて\n一度もない。"
    "不过，她从没带过任何人\n到家里玩过。"

# game/script.rpy:358
translate zh_cn start_3da469ec:

    # "腕を引きずられながら改札をくぐると\nそこには、よく見知った姿があった。"
    "被树里拽着手臂，我穿过了检票口，\n结果看到了一个熟悉的身影。"

# game/script.rpy:363
translate zh_cn start_cc29f887:

    # r "あの……ど、ども……"
    r "那个……你、你好……"

# game/script.rpy:365
translate zh_cn start_31dadae6:

    # i "……古澤……？"
    i "……古泽……？"

# game/script.rpy:367
translate zh_cn start_24a62acd:

    # "たしかに古澤（ふるさわ）だ。"
    "的确是古泽。"

# game/script.rpy:369
translate zh_cn start_3c3a4bd2:

    # "緊張にこわばったまま、\n少女はまた、ぺこんと頭を下げた。"
    "少女身体僵硬，紧张到低下了头。"

# game/script.rpy:371
translate zh_cn start_bde25c69:

    # i "どうしてきみが？"
    i "你怎么在这儿？"

# game/script.rpy:373
translate zh_cn start_aba40e81:

    # r "あの、それはですね……"
    r "那个，那是因为……"

# game/script.rpy:375
translate zh_cn start_baa945ce:

    # "舌がもつれ、みるみる赤くなる。\n間違いなくバイト先の後輩、\n古澤だった。"
    "这个舌头打结，转眼间脸就变红了的少女，\n毫无疑问，是我打工场所的后辈──古泽。"

# game/script.rpy:377
translate zh_cn start_24087423:

    # j "ねえ、\n話は家に戻ってからで\nいいじゃない。"
    j "呐，\n有事回家再说吧。"

# game/script.rpy:379
translate zh_cn start_087fe7b9:

    # j "潤ちゃん、\n傘の予備は？"
    j "润酱，\n有多带伞吗？"

# game/script.rpy:381
translate zh_cn start_123d0ef6:

    # r "え？　ないよ。\nいきなり出てきたし。"
    r "啊？　没有呢。\n毕竟突然就出门了。"

# game/script.rpy:383
translate zh_cn start_f848d829:

    # "樹里は\nとまどう相手の手元を\nぶしつけに観察する。"
    "突然，树里冷不防地盯向古泽，\n目光落在她手里握着的伞上。"

# game/script.rpy:389
translate zh_cn start_392c87cc:

    # j "そっちのが大きい。\nね、交換しよ。"
    j "你那把更大。\n呐，和我换换呗。"

# game/script.rpy:391
translate zh_cn start_8ddbadf5:

    # r "これ？\nあ、うん。"
    r "换伞？\n啊，行。"

# game/script.rpy:393
translate zh_cn start_ddbd7690:

    # "樹里は、古澤の手から、\nこうもり傘を受け取り、\nそのまま僕に手渡した。"
    "树里从古泽手中接过雨伞，\n径直递给了我。"

# game/script.rpy:395
translate zh_cn start_4376ac1d:

    # j "というわけで\n兄さん入れてねえ。"
    j "就这样，\n你跟哥哥打一把伞吧。"

# game/script.rpy:397
translate zh_cn start_a9d76a6c:

    # i "また自分だけ\n楽しようとする。"
    i "你又只顾自己快活了。"

# game/script.rpy:399
translate zh_cn start_074fef1e:

    # j "いいじゃない、\nせっかく可愛い妹が\n迎えにきたんだし。"
    j "有什么关系嘛，\n难得有可爱的妹妹来接哥哥，\n看这个份上我这样做也行吧。"

# game/script.rpy:401
translate zh_cn start_d0808353:

    # i "可愛い妹は、\nそんなこと自分で言わないだろ。"
    i "真正可爱的妹妹\n可不会这么自夸吧。"

# game/script.rpy:406
translate zh_cn start_0f6bc1f7:

    # i "まったく。\nごめんな古澤。"
    i "真是的……\n不好意思啊，古泽。"

# game/script.rpy:411
translate zh_cn start_7570f79a:

    # r "い、いえ、\nぜんぜん、別に。"
    r "没、没什么，\n我完全不要紧的。"

# game/script.rpy:416
translate zh_cn start_cfe22161:

    # j "もう、はやく帰ろ。\nあ、コンビニ寄らしてね。"
    j "还是早点回去吧。\n啊，或者便利店逛逛？"

# game/script.rpy:418
translate zh_cn start_3b124f7e:

    # i "どっちなんだよ。"
    i "到底是想怎样啊。"

# game/script.rpy:424
translate zh_cn start_626bcf53:

    # "傘をひろげた僕の脇に、\nちゃっかり寄り添ってくる。"
    "当我撑起伞时，\n树里又趁机钻入我的臂膀下，\n熟稔地依在我的身上。"

# game/script.rpy:426
translate zh_cn start_74d466ef:

    # "ゆるくした襟元からは\nきゃしゃな鎖骨がのぞいていた。"
    "她纤细的锁骨，\n从松开的领口若隐若现。"

# game/script.rpy:428
translate zh_cn start_b756d049:

    # "春以来に顔をあわせる樹里は\n変わらない。"
    "自春天一别至今再见，\n没看出树里她有什么变化。"

# game/script.rpy:430
translate zh_cn start_19821bca:

    # "いきいきと輝いて\n僕を、まっすぐに見る。"
    "她一如既往充满活力，\n注视我的眸光也始终熠熠笔直。"

# game/script.rpy:454
translate zh_cn start_f3624e31:

    # "物心ついたころから、\n芳野さんは僕らの輪のなかにいた。"
    "自打记事起，\n芳野阿姨的身影便如影随形地融入了我们的生活。"

# game/script.rpy:456
translate zh_cn start_71e08ed5:

    # "中学にあがるまでは、僕も、樹里も、\n「芳野さん」ではなく、\n「芳野母さん」と呼んだ。"
    "直到我升入中学前，\n树里与我都称呼她为「芳野妈妈」，\n而非略显生分的「芳野阿姨」。"

# game/script.rpy:458
translate zh_cn start_5c6989e2:

    # "そんな芳野さんと父さんとの再婚は\nべつに意外でもなく、\nわかりきっていたことだ。"
    "因此，对于父亲与她的再婚，\n我并不感到意外，\n反倒觉得是顺理成章。"

# game/script.rpy:460
translate zh_cn start_f4089df9:

    # "ただ、悪い噂が立つのを避けて、\n時間を置いていただけなんだろう。"
    "想来他们只是为了避免流言蜚语，\n才特意将婚期推迟至今吧。"

# game/script.rpy:462
translate zh_cn start_4936ae96:

    # "朱音母さんが死んでから、\n一年半がすぎた。"
    "在我和树里的生母朱音离世一年半之后，\n才迈出了这一步。"

# game/script.rpy:464
translate zh_cn start_d088c0e8:

    # "さっきまで同席していた\n茂晴伯父にしても、はやくから\nしきりに再婚を勧めていたくちだ。"
    "就连方才还在座的茂晴伯父，\n其实也早早就时常劝说父亲再婚了。"

# game/script.rpy:466
translate zh_cn start_a2f5f170:

    # "いまさら僕や樹里が\n反対する理由なんて\nなにも無い。"
    "而我和树里，自然没有反对的理由。"

# game/script.rpy:468
translate zh_cn start_8fdb9de9:

    # "ただ芳野さんに\n娘がいたのは意外だった。"
    "唯一让我感到意外的，\n是芳野阿姨的这个女儿。"

# game/script.rpy:470
translate zh_cn start_51d2d7d5:

    # "いや、正直に言うなら、\n手のかからない娘がいる、\nと聞いたことはあった。"
    "老实说，\n我之前听芳野阿姨提及过，\n她有个不需操心的女儿。"

# game/script.rpy:472
translate zh_cn start_cfa24f3c:

    # "けれど、芳野さん本人が、\nそれ以上はあまり\n語らなかったし、"
    "然而芳野阿姨也没主动说过更多的了，\n我也没进一步打听。"

# game/script.rpy:474
translate zh_cn start_ed738e38:

    # "一緒に連れてくることも\n無かったから、これまで\n気にかけることがなかった。"
    "之前也没见过芳野阿姨带她女儿来，\n因此，我也未曾将此事挂在心上。"

# game/script.rpy:476
translate zh_cn start_3405fb04:

    # "だから今日の本題は、\n再婚する二人が、家族に\n了解を得るというよりも、"
    "所以今天的主题，\n与其说是让再婚的两人征得家人的理解，"

# game/script.rpy:478
translate zh_cn start_21270fb8:

    # "古澤を───いや潤を\n新しい家族として、\nぼくらに紹介するってことなんだろう。"
    "倒不如说是把古泽——\n不对，\n是把润作为家里新的一员来介绍吧。"

# game/script.rpy:480
translate zh_cn start_5234dc41:

    # "芳野さんにうながされ\n潤は、いずまいを正した。"
    "在芳野阿姨的轻声催促下，\n润端正了坐姿。"

# game/script.rpy:485
translate zh_cn start_1f359d7a:

    # r "潤です。\nよろしくお願いします。"
    r "我是润，\n今后请多多关照！"

# game/script.rpy:487
translate zh_cn start_5b00f5b9:

    # "まだ緊張が残っているけれど、\nしっかりとした挨拶。"
    "问候语虽略显拘谨，\n却十分认真得体。"

# game/script.rpy:489
translate zh_cn start_e535b544:

    # "彼女のバイト初日も\nそうだった。"
    "就像她第一天上班时那样。"

# game/script.rpy:491
translate zh_cn start_c5eea598:

    # "潤は、童顔の残る見かけとは反対に\n頼りになる後輩だった。"
    "与有些稚气的外表相反，\n润是个很可靠的后辈。"

# game/script.rpy:493
translate zh_cn start_a8b1c315:

    # "芳野さんが微笑みを浮かべながら\n樹里に言った。"
    "芳野阿姨露出微笑，\n对树里说道："

# game/script.rpy:500
translate zh_cn start_132b6be1:

    # y "樹里は、覚えていたのね。\n潤のこと。"
    y "树里还记得润吧？"

# game/script.rpy:505
translate zh_cn start_8056770d:

    # j "うん。もちろん。"
    j "嗯，当然。"

# game/script.rpy:507
translate zh_cn start_6aba6b9d:

    # "そう屈託なく答える。"
    "树里爽朗的回答显得毫不迟疑。"

# game/script.rpy:509
translate zh_cn start_33281123:

    # j "むかし、\n古い建物の中庭で、\n一緒に遊んだよね。"
    j "很久以前，\n在旧楼的中庭里，\n我们一起玩过吧？"

# game/script.rpy:511
translate zh_cn start_ec41c819:

    # i "……それ、どこ？"
    i "……旧楼？那是哪儿？"

# game/script.rpy:513
translate zh_cn start_8a414d32:

    # f "きみの青山のアパートへ\n連れて行った時だ。"
    f "是我之前，\n带你去青山公寓那会儿。"

# game/script.rpy:515
translate zh_cn start_b74efb13:

    # f "五樹は小学校にあがったくらいだ。"
    f "那时候五树才刚上小学吧。"

# game/script.rpy:517
translate zh_cn start_d25275c6:

    # y "ええ。\nもう、あそこも\n取り壊されてしまったけれど。"
    y "是呀，\n不过，现在那里已经被拆了。"

# game/script.rpy:519
translate zh_cn start_400430b7:

    # y "そうね、\n十年以上も前のことだから、\n憶えていなくても無理はないわ。"
    y "毕竟十多年前的事了，\n你不记得也正常。"

# game/script.rpy:525
translate zh_cn start_7ef750ed:

    # y "フフッ"
    y "扑哧。"

# game/script.rpy:527
translate zh_cn start_0eedcb18:

    # "芳野さんが声を弾ませると、\n潤はぎくりと顔をこわばらせた。"
    "听到芳野阿姨的清脆笑声，\n润的表情却一下子僵住了。"

# game/script.rpy:532
translate zh_cn start_62f7e154:

    # y "潤ったら、ノラ猫を怖がって\n泣き出してしまって……"
    y "那时小润她呀，被野猫吓到，\n都哭出来了……"

# game/script.rpy:534
translate zh_cn start_da1bf3fd:

    # y "五樹お兄ちゃんに\n助けてもらったのよね？"
    y "当时是五树哥哥帮了你吧？"

# game/script.rpy:539
translate zh_cn start_58e89040:

    # r "マ……ッ"
    r "妈……！"

# game/script.rpy:541
translate zh_cn start_52c024c3:

    # i "へえ。"
    i "哦？"

# game/script.rpy:546
translate zh_cn start_4349e784:

    # r "マ、ママッ！\nそういう事……っ"
    r "妈、妈妈！\n这种事就别提了……"

# game/script.rpy:551
translate zh_cn start_4d00bbc1:

    # y "はいはい。"
    y "好啦好啦。"

# game/script.rpy:553
translate zh_cn start_2bddf7b7:

    # j "……へえー。"
    j "嘻嘻……"

# game/script.rpy:559
translate zh_cn start_b7353cad:

    # "一呼吸おいて、\n父さんは潤に頭をさげた。"
    "父亲顿了顿，\n向润低头致意。"

# game/script.rpy:561
translate zh_cn start_c3bfe742:

    # f "ありがとう、潤。"
    f "谢谢你，润。"

# game/script.rpy:563
translate zh_cn start_7e91dfa9:

    # f "きみが再婚に\n納得してくれたことは、\n恩にきるよ。"
    f "真心谢谢你，\n谢谢能同意这桩婚事。"

# game/script.rpy:565
translate zh_cn start_70024a19:

    # f "こうして一緒に\nとうかんもりに\n来てくれたことも。"
    f "也同时谢谢你\n愿意这样来到稻荷森。"

# game/script.rpy:570
translate zh_cn start_b793704c:

    # r "……（こくり）"
    r "……"

# game/script.rpy:572
translate zh_cn start_8ab77232:

    # "しゃちこばって\n潤はうなずく。"
    "润拘谨地点了点头。"

# game/script.rpy:574
translate zh_cn start_95fb9896:

    # f "芳野さんがうちに籍を入れて\n潤は、五樹にとっては妹、\n樹里には、お姉さんになったわけだ。"
    f "我和芳野成为夫妻，\n同时意味着润成了五树的妹妹和树里的姐姐。"

# game/script.rpy:576
translate zh_cn start_10db74df:

    # f "ただまあ、お互い齢も近いことだし、\nいきなり兄妹のように、とは\nいかないだろう。"
    f "不过你和五树都长大了，\n不太可能立刻像亲兄妹那样相处。"

# game/script.rpy:578
translate zh_cn start_a2b2b984:

    # f "だからひとまず、\n友達として、\n接してあげてくれないか。"
    f "所以，能否先试着成为朋友？"

# game/script.rpy:580
translate zh_cn start_e71c9b4f:

    # r "は、はい。"
    r "啊，好的。"

# game/script.rpy:585
translate zh_cn start_865da23b:

    # r "こちらこそ、\nおねがい、します。"
    r "这应该由我来说才对，\n还请大家能多多关照。"

# game/script.rpy:587
translate zh_cn start_899546f1:

    # f "五樹と樹里も。"
    f "五树跟树里也来。"

# game/script.rpy:589
translate zh_cn start_dba3d2c1:

    # "うなずいた僕のとなりで、\n樹里はオーバーにうけあった。"
    "在选择点头回应的我的身旁，\n树里夸张地担保道："

# game/script.rpy:595
translate zh_cn start_5a195a64:

    # j "大丈夫、父さん。\n親友になれるわ、私たち。"
    j "爸爸别担心，我们会成为好姐妹的。"

# game/script.rpy:597
translate zh_cn start_eb606277:

    # j "夏休みが終わったら、\n一緒に登校できるよね？"
    j "暑假结束后，\n上学就该一块儿走了，对吧？"

# game/script.rpy:602
translate zh_cn start_7b8a1782:

    # r "そ、そう思うけど。\n……ママ？"
    r "应、应该是这样的……\n妈妈？"

# game/script.rpy:604
translate zh_cn start_37cbe079:

    # y "樹里とは同じ学校よ。\nこれからは列車通学ね。"
    y "你和树里在同一所学校哦，\n以后要乘列车上下学了呢。"

# game/script.rpy:606
translate zh_cn start_6df1d310:

    # j "すっごいヒマなの～\n列車通学って。"
    j "乘列车上学，\n超～悠闲的。"

# game/script.rpy:608
translate zh_cn start_4b56bdc5:

    # i "進学を考えてるんだったら、\n普通は通学時間には\n勉強してるだろう。"
    i "如果想升学的话，\n一般都要在通勤时间学习吧。"

# game/script.rpy:613
translate zh_cn start_e495f475:

    # j "兄さん、\n勉強は学校でするのよ。"
    j "哥哥，\n学习这种事在学校里弄就行了吧。"

# game/script.rpy:615
translate zh_cn start_d6b88a2b:

    # i "……あ、そう。"
    i "……啊，是么？"

# game/script.rpy:617
translate zh_cn start_5fa1b381:

    # "とりたてて\n勉強しているそぶりなどないのに、\n樹里の成績は良好らしい。"
    "树里平日里\n也看不出多用功，\n成绩倒不错。"

# game/script.rpy:619
translate zh_cn start_c0ea5c31:

    # "まったく、うらやましい。"
    "真是令人羡慕啊。"

# game/script.rpy:624
translate zh_cn start_09e11a5e:

    # j "でも楽しみだな。\nワクワクする。"
    j "不过真让人期待呢。\n心里都雀跃起来了。"

# game/script.rpy:626
translate zh_cn start_e42831d8:

    # "ふっと、樹里は\n新しい家族二人を見比べた。"
    "树里来回望着这两位新家人。"

# game/script.rpy:631
translate zh_cn start_86434d3a:

    # j "……ママ……かあ。"
    j "……妈妈……啊。"

# game/script.rpy:636
translate zh_cn start_220b0e4c:

    # j "私も芳野ママって\n呼んでいい？　よね？"
    j "我也可以叫芳野妈妈吧？\n可以吧？"

# game/script.rpy:638
translate zh_cn start_7947c085:

    # "ずき、と\n胸が痛んだ。"
    "心头\n倏地一痛。"

# game/script.rpy:640
translate zh_cn start_1be4bd4d:

    # y "ええ。嬉しいわ。"
    y "当然，我很乐意。"

# game/script.rpy:645
translate zh_cn start_28277e64:

    # r "…………"
    r "…………"

# game/script.rpy:651
translate zh_cn start_da07c52f:

    # "やわらかな芳野さんの声が\nつらかった。"
    "芳野阿姨那温和的声音，\n于我却像是一把钝刀。"

# game/script.rpy:656
translate zh_cn start_89ec3b07:

    # y "五樹は、灯籠流しまではいられるの？"
    y "五树能留到放河灯的时候吗？"

# game/script.rpy:658
translate zh_cn start_bf2257c4:

    # i "……っと、週末だっけ。"
    i "……好像是周末吧。"

# game/script.rpy:663
translate zh_cn start_14bc020a:

    # j "そうよ、兄さん。\nまたすぐに帰ったりしたら、\nいやよ？"
    j "是哦，哥哥。\n你可不要又太早回去了哟。"

# game/script.rpy:685
translate zh_cn start_73c28fa6:

    # "鉛色の雲がのしかかる。"
    "铅云低垂，压在天空的尽头。"

# game/script.rpy:689
translate zh_cn start_ed4d61df:

    # "───晩秋の突然の雨。"
    "——雨，不期而至，侵袭了晚秋。"

# game/script.rpy:693
translate zh_cn start_94ddd80b:

    # "２軒目の喫茶店も、また、\n休日というのに、混みあっていた。"
    "都是第二家咖啡馆了，虽然是节假日，\n但依然人满为患。"

# game/script.rpy:695
translate zh_cn start_8bc26959:

    # "「ただいま喫煙席での\n　相席となりますが」"
    "「只能在吸烟区拼桌了，\n　可以吗？」"

# game/script.rpy:697
translate zh_cn start_455039c0:

    # "そう言われて悩んだが\nもういちど外の様子を見て\n仕方なく、はいと答えた。"
    "服务员的话让我有些犹豫，\n但瞥了一眼窗外阴沉的天气，\n别无选择，只好答应了。"

# game/script.rpy:699
translate zh_cn start_c6f68253:

    # "通された席では、\n白衣をはおった男性が\n書類に目を通している。"
    "我对面坐着的是一名男子，\n一身白大褂，专注地翻阅文件。"

# game/script.rpy:701
translate zh_cn start_ee58b0e4:

    # "床についたクラッチの先端が視界に入ると\n男性は、吸い始めたばかりの煙草を\nすっと灰皿に置いた。"
    "当拄地的拐杖尖端映入眼帘时，\n男子将刚点燃的香烟轻轻按入烟灰缸，\n就这样把烟灭了。"

# game/script.rpy:703
translate zh_cn start_346a96bb:

    # q "あ、構いませんよ。"
    q "啊，我不介意的。"

# game/script.rpy:705
translate zh_cn start_f5ad3189:

    # "男性は無言でうなずいて、\n書類に目を戻した。\n煙草には、もう手を伸ばさない。"
    "男子微微颔首，\n目光依旧停留在文件上。\n看着对那支烟毫无兴趣似的。"

# game/script.rpy:711
translate zh_cn start_8f4ff0a2:

    # "カフェラテが\n半分になる。"
    "拿铁已经喝掉了一半。"

# game/script.rpy:713
translate zh_cn start_02e758ce:

    # "かるく出窓にもたれ、\n外へ視線を向けた。"
    "我轻轻倚在窗边，目光投向外侧。"

# game/script.rpy:715
translate zh_cn start_39a8e5d4:

    # "濡れた路面を、ビー玉に似た\nヘッドライトの光がはねていく。"
    "车灯在湿漉漉的路面上闪烁，\n光斑像一颗颗轻盈跃动的玻璃珠。"

# game/script.rpy:717
translate zh_cn start_7f6da78a:

    # "それから、ちびちびと\n何度かカップに口をつけたころ\n相席の男性の視線に気づいた。"
    "就这样小口地啜饮着咖啡，\n几次之后，\n才察觉到了对面男子的目光。"

# game/script.rpy:721
translate zh_cn start_595b02d7:

    # "吸い寄せられるように\n顔が向き合うと、男性は一礼して、\n意外なことを言った。"
    "仿佛被吸引般，我抬起了头抬起头，与他四目相对。\n他微微欠身，说出一句意想不到的话。"

# game/script.rpy:723
translate zh_cn start_0dac9bf3:

    # g "Ｒ大の方……でしょうか？"
    g "您是Ｒ大的学生……吧？"

# game/script.rpy:725
translate zh_cn start_92f24323:

    # q "え？"
    q "啊？"

# game/script.rpy:727
translate zh_cn start_5fc6adc7:

    # q "はいそうです。"
    q "嗯，是的。"

# game/script.rpy:729
translate zh_cn start_bce20bae:

    # q "えっと、どこかで？"
    q "那个，我们见过吗？"

# game/script.rpy:731
translate zh_cn start_0c8a76b4:

    # g "やっぱりですか。\n驚いたな。"
    g "果然没错，\n认出您时我自己也吃了一惊。"

# game/script.rpy:733
translate zh_cn start_90bcbe48:

    # g "お話ししたことはありません。\nＲ大の近くで、\nお見かけしただけです。"
    g "我们之前并未交谈过，\n我只是曾在Ｒ大附近见过您几次。"

# game/script.rpy:735
translate zh_cn start_90d7e969:

    # g "ただ、共通の知り合いが\nいるのじゃないかと思って───"
    g "冒昧搭话，只是想着，\n或许我们有个共同的熟人———"

# game/script.rpy:737
translate zh_cn start_301fc492:

    # "男性は軽く咳払いをした。"
    "男子轻轻清了清嗓子。"

# game/script.rpy:739
translate zh_cn start_a1fceaed:

    # g "簸川ってご存じですか？\n観光学部の。"
    g "您认识簸川吗？\n旅游管理专业的那位。"

# game/script.rpy:741
translate zh_cn start_879bb7b6:

    # "長身で痩せた男性の声は、\nおもいのほか深く、\nざわついた店のなかでも、すっと届いた。"
    "这位削高挑的男子的声音出乎意料地低沉，\n在嘈杂的店内依然清晰可闻。"

# game/script.rpy:743
translate zh_cn start_d9321bea:

    # "私は、ぎごちなくうなずく。"
    "我生硬地点了点头。"

# game/script.rpy:745
translate zh_cn start_af5a7768:

    # "山鹿青磁と名乗った男性は、\nあの簸川五樹の、旧友だった。"
    "这位自称山鹿青磁的男子，\n竟是簸川五树的发小。"

# game/script.rpy:747
translate zh_cn start_74dc7862:

    # "ふだんは都内の病院に勤めているが、\n母校に用があって、たまたま\nこの界隈に来ているのだと。"
    "他告诉我，他在东京都内的医院工作，\n今天因母校的事务偶然来到这一带。"

# game/script.rpy:749
translate zh_cn start_133b2f3c:

    # "まじめそうな人だ。\n私は素直に耳を傾ける。"
    "能感到他的言辞很诚恳，\n我就这么静静地倾听着。"

# game/script.rpy:751
translate zh_cn start_cc749750:

    # g "すみません、\nぶしつけなことを聞いてしまって。"
    g "抱歉，问了这么唐突的问题。"

# game/script.rpy:753
translate zh_cn start_69366db9:

    # q "いえ、ぜんぜん。\n山鹿さんはお医者さん……なんですか？"
    q "不，没关系的。\n山鹿君……您是医生吗？"

# game/script.rpy:755
translate zh_cn start_f85ba230:

    # q "それとも研修医さんとか……"
    q "或者说是实习医生？"

# game/script.rpy:757
translate zh_cn start_5b8e0a22:

    # g "え？\nああ、そうか。"
    g "诶？啊，这个啊。"

# game/script.rpy:759
translate zh_cn start_b2e740cb:

    # "青磁さんは、\n自分の白衣を指さし笑った。"
    "青磁先生指了指自己的白大褂，笑了笑。"

# game/script.rpy:761
translate zh_cn start_a1322a9b:

    # g "いえ、違います。\n医者ではありません。"
    g "不不不，我不是医生。"

# game/script.rpy:763
translate zh_cn start_ee1e919e:

    # g "医者の手伝いをするほうの\n専門職ですよ。"
    g "算是给医生打下手的吧，\n不过是专业的。"

# game/script.rpy:765
translate zh_cn start_391c6a52:

    # g "学生時代のクセで、\nつい学内から着込んできてしまった。"
    g "穿这身是学生时代的习惯，\n偶尔会不经意地把它穿在外套里面。"

# game/script.rpy:767
translate zh_cn start_017a0dc9:

    # q "それじゃあ、\nお茶の水橋の向こうの？"
    q "您是茶水桥对面那所学校的？"

# game/script.rpy:769
translate zh_cn start_fbcbac96:

    # g "ええ。Ｉ大付属の卒業です。"
    g "对，我是Ｉ大附属学校的毕业生。"

# game/script.rpy:771
translate zh_cn start_8a0ae855:

    # g "五樹は───簸川はどうですか。"
    g "五树他——簸川他现在过得怎样？"

# game/script.rpy:773
translate zh_cn start_830ba81e:

    # g "いや、初めて話す方に、\nそんな聞き方はないな。"
    g "不，对初次见面的人这么问不太合适吧。"

# game/script.rpy:775
translate zh_cn start_4094c0e2:

    # g "すみません。\nあいつ、なかなか自分の事は\n言わないものですから、つい。"
    g "抱非常歉。\n只是那家伙从不谈论自己，\n所以我还是这样问了……"

# game/script.rpy:777
translate zh_cn start_7e98853e:

    # q "…………"
    q "…………"

# game/script.rpy:779
translate zh_cn start_2dd0e3d0:

    # "どうしたらいいだろう。\nこの人はきっと誤解している。"
    "我该如何回应呢？\n他一定是误会了什么。"

# game/script.rpy:781
translate zh_cn start_a0b82657:

    # "仕事柄なのか、初対面でも青磁さんは\n自然で、へんな馴れ馴れしさもない。"
    "或许是因为职业的缘故，\n即便是初次对话，\n青磁先生的言辞也显得自然而不拘谨。"

# game/script.rpy:783
translate zh_cn start_9d80692a:

    # "私は時には白衣姿にすら嫌悪感を\nおぼえるのに、不思議と\nそういう気持ちには、ならなかった。"
    "我向来对穿白大褂的人有些抵触，\n但奇怪的是，对他却并无这种感觉。"

# game/script.rpy:785
translate zh_cn start_f9a15f09:

    # "あの人……"
    "他啊……"

# game/script.rpy:787
translate zh_cn start_128717d5:

    # "簸川五樹との、あまりおだやかとは\n言えない関係を、ありていに\n語ってしまうのは、ためらわれた。"
    "正当我犹豫着\n是否该如实告知我与簸川五树之间\n那微妙的关系时，"

# game/script.rpy:789
translate zh_cn start_d334cad0:

    # "青磁さんが続ける。"
    "青磁先生再次开口。"

# game/script.rpy:791
translate zh_cn start_304374bb:

    # g "以前、学校の近くで\n簸川と落ち合った時に、\nちょうどあなたが通りがかって……"
    g "以前在学校附近与簸川碰面时，\n曾看到你经过……"

# game/script.rpy:793
translate zh_cn start_410e7820:

    # g "同じサークルの方だと、\n聞きました。"
    g "听五树说你们是同一个社团的。"

# game/script.rpy:795
translate zh_cn start_9fb48730:

    # g "そのほかは何も\nべつだん言ってなかったが───"
    g "虽然除此之外，他也没多说别的——"

# game/script.rpy:797
translate zh_cn start_841dc23a:

    # g "ただ、あなたのことは、\n気にしてるふうだったので。\n私も、印象に残っていたんです。"
    g "只是，似乎，他很在意你，\n所以我就记住你了。"

# game/script.rpy:799
translate zh_cn start_119cb3c9:

    # g "それで、つい尋ねてしまいました。\nすいません。突然すぎました。"
    g "于是就不由自主地问了……\n抱歉，这有些突兀吧。"

# game/script.rpy:801
translate zh_cn start_7aa131c0:

    # "いえ、と私は首をふり、\nできるだけ邪険にならないように、\n切り出した。"
    "「没关系的。」\n我摇了摇头，尽量让语气显得平静。"

# game/script.rpy:803
translate zh_cn start_aeb06726:

    # q "あの、私、もうサークルには\n入ってないんです。"
    q "那个，我已经退出社团了。"

# game/script.rpy:805
translate zh_cn start_d5c6ef43:

    # "青磁さんの表情に、\nちいさな変化があった。"
    "青磁先生的表情微微变化。"

# game/script.rpy:807
translate zh_cn start_4ed51337:

    # q "ちょっと、個人的な事情で……"
    q "因为一些个人的原因……"

# game/script.rpy:809
translate zh_cn start_0ae55869:

    # g "そうだったんですか。"
    g "这样啊。"

# game/script.rpy:811
translate zh_cn start_baf5d177:

    # q "結局、あまりサークルの活動にも\n熱心になれなかったので、簸川さんとも、\nほとんどお話ししたことが無いんです。"
    q "在社团时也没怎么参与活动，\n和簸川君也没说过几句话。"

# game/script.rpy:813
translate zh_cn start_4d4b91cf:

    # g "……なるほど。"
    g "……原来如此。"

# game/script.rpy:815
translate zh_cn start_9714f815:

    # g "すみません。\nこちらの勘違いで、\n先走った話をしてしまいました。"
    g "刚才的话可能让你困扰了，实在抱歉。"

# game/script.rpy:817
translate zh_cn start_5e5cf9db:

    # q "いえ、いいんです。"
    q "没什么，不必在意。"

# game/script.rpy:819
translate zh_cn start_1091a9e7:

    # "肩をすくめる青磁さんに\n悪い気がした。"
    "看着青磁先生肩膀耷拉下来，\n我有些过意不去。"

# game/script.rpy:821
translate zh_cn start_f4255b5e:

    # q "でも、そうですね、\n私の知る限りでしたら……"
    q "不过，如果你希望的话，\n我可以告诉你一些我知道的事。"

# game/script.rpy:823
translate zh_cn start_c8b311bd:

    # g "ええ、構いません。"
    g "啊，那有劳了。"

# game/script.rpy:825
translate zh_cn start_39820ee2:

    # q "簸川さんは、ご友人も多いし、\nサークルでも好かれる人でしたよ。"
    q "簸川君有很多朋友，\n在社团里人气很高。"

# game/script.rpy:827
translate zh_cn start_b332c2de:

    # q "御本人は、はしゃいだりする\nタイプではないのに、\nまわりが自然と明るくなるような。"
    q "他本人并不算开朗，\n但却能让周围的人自然地变得轻松。"

# game/script.rpy:829
translate zh_cn start_878d3618:

    # g "…………"
    g "…………"

# game/script.rpy:831
translate zh_cn start_ff523a22:

    # "そのとき、\nほんのせつな───"
    "就在那一瞬间——"

# game/script.rpy:833
translate zh_cn start_28ffef0b:

    # "眼差しが、私の心中を\n透かし見ている気がした。"
    "他的目光仿佛洞彻了我。"

# game/script.rpy:835
translate zh_cn start_d80c23ea:

    # g "……そうですか。\nありがとう。"
    g "是这样啊……谢谢你。"

# game/script.rpy:837
translate zh_cn start_7a54042a:

    # "青磁さんは静かにうなずいた。"
    "青磁先生轻轻点头。"

# game/script.rpy:839
translate zh_cn start_96c486f0:

    # g "なぜかつい、あいつとあなたは\n心安い仲じゃないか、なんて\n思ってしまって───"
    g "不知为何，\n我总觉得你们之间似乎有着\n某种特别的关系——"

# game/script.rpy:841
translate zh_cn start_a02b8ba7:

    # q "いえ……\n気になさらないで\nください。"
    q "……没关系，请不要在意。"

# game/script.rpy:843
translate zh_cn start_35904f50:

    # "あとは、\nとりとめのない会話。"
    "之后的对话变得无关紧要，漫无边际了。"

# game/script.rpy:845
translate zh_cn start_a549663c:

    # "別れぎわ、もう会う機会は無いと\n思っていたが\n知らず名乗っていた。"
    "分别时，\n虽然觉得彼此不会再见面，\n但我还是报上了自己的名字。"

# game/script.rpy:847
translate zh_cn start_4152a66d:

    # q "伊勢です、\n伊勢きりこです。"
    q "我是伊势，伊势雾子。"

# game/script.rpy:849
translate zh_cn start_82151b6f:

    # "簸川と話す機会があっても、\nこのことは内緒にしてください、と\n青磁さんは頭を下げ、店を離れた。"
    "「我们的对话还烦请不要让簸川知道。」\n青磁先生低头致意后，离开了。"

# game/script.rpy:854
translate zh_cn start_747f2635:

    # q "……ふぅ……"
    q "……呼……"

# game/script.rpy:856
translate zh_cn start_faddfc41:

    # "なかなか雨は\n降りやもうとしない。"
    "雨似乎还不会停。"

# game/script.rpy:858
translate zh_cn start_58190841:

    # "気を利かせて置いていってくれた傘を\n使うべきかとためらっているうちに、\n外は暗くなる。"
    "在我犹豫着是否该用他留下的体贴——\n他给我的一把雨伞时，\n窗外天色渐暗。"

# game/script.rpy:860
translate zh_cn start_516ff635:

    # "灰皿にぽつんと残った\n吸い殻に視線を落とす。"
    "我看向烟灰缸里孤零零的烟蒂。"

# game/script.rpy:862
translate zh_cn start_48683be9:

    # "……大人びたひとだった。"
    "……真是成熟啊。"

# game/script.rpy:864
translate zh_cn start_2607152e:

    # "自分とさほど\n年齢も変わらないのに。"
    "明明和我年纪相仿。"

# game/script.rpy:866
translate zh_cn start_2cc48351:

    # "あの人と、あの人。\nどこかが似ていた。"
    "他和他，\n在某些方面竟如此相似……"

# game/script.rpy:868
translate zh_cn start_3a30fcf2:

    # "それが、\n寂しさだったと気づくのは、\nそれから１年が経ったころだった。"
    "可其实这并不是成熟，\n而是孤独与寂寞——\n这是一年之后的我，才能明白的。"

# game/script.rpy:892
translate zh_cn start_e0a34dd7:

    # "帰省した翌日。"
    "归省翌日。"

# game/script.rpy:894
translate zh_cn start_f080b6d0:

    # "とうかんもりを案内するから、\nと諭して、しぶりがちな潤を\n外へと連れ出した。"
    "应家里要求，我要向润介绍稻荷森。\n我把一脸苦涩的润带到了外面。"

# game/script.rpy:899
translate zh_cn start_9c0b19f6:

    # j "あたし、\nうちにいようか？"
    j "那我呢？那我呢？"

# game/script.rpy:901
translate zh_cn start_af225334:

    # "同行をことわると、\n樹里はあっさりと\nひきさがった。"
    "被拒绝同行后，树里居然很干脆地放弃了。"

# game/script.rpy:903
translate zh_cn start_88cb90eb:

    # j "うん、いいよ。\nお手伝いしてるからさ。"
    j "嗯，那我就在家帮忙干家务活吧！"

# game/script.rpy:905
translate zh_cn start_4722ce63:

    # j "いってらっしゃい。\n兄さん、潤ちゃん。"
    j "哥哥，润酱，路上小心～"

# game/script.rpy:918
translate zh_cn start_c91e202b:

    # "草いきれの中をつづく\n廃線跡。"
    "废弃的铁轨在青草丛中蜿蜒。"

# game/script.rpy:920
translate zh_cn start_5b82ef2c:

    # "道がわりの線路なんて、はじめてだと、\n慎重に嬉しさを隠しながら\n潤は言った。"
    "「我还是第一次见到这样的换道线路。」\n相比平日的慎重，\n此刻润的话语中多了份欣喜。"

# game/script.rpy:922
translate zh_cn start_d5d317b2:

    # i "そういや、古澤───"
    i "对了，古泽——"

# game/script.rpy:924
translate zh_cn start_297212ad:

    # i "あ、こう呼ぶのは\nもうだめなのかな。"
    i "啊，现在已经不该这么叫了吧。"

# game/script.rpy:926
translate zh_cn start_8851e430:

    # i "だったら……\n潤って呼んでも大丈夫かい。"
    i "那……我可以叫你「润」吗？"

# game/script.rpy:928
translate zh_cn start_9a03643f:

    # "レール上を、ふらふらと\nたどり歩いていた潤は、\nくるっと僕を振り向いた。"
    "润正摇摇晃晃地走在铁轨上，\n听到我的话后猛地转过头。"

# game/script.rpy:930
translate zh_cn start_fa5c4d37:

    # r "ふぇっ？"
    r "诶？"

# game/script.rpy:932
translate zh_cn start_1e89a38c:

    # r "ったった───"
    r "啊呀———"

# game/script.rpy:934
translate zh_cn start_9c938c03:

    # "バランスをくずして、\nこっちの肩に手をつく。"
    "她失去平衡，手搭到了我的肩膀上。"

# game/script.rpy:939
translate zh_cn start_e8206cbf:

    # r "そ……それじゃあ私は\nお、お、お兄さん、ですか？"
    r "那、那我该叫你哥、哥、哥哥吗？"

# game/script.rpy:941
translate zh_cn start_6266bebf:

    # "うらめしそうに\nこぼす。"
    "她不满地嘟囔道。"

# game/script.rpy:943
translate zh_cn start_a0e60fdc:

    # i "だったら、アニキとか。"
    i "不行的话……就叫「大哥」之类的？"

# game/script.rpy:945
translate zh_cn start_0d8417a2:

    # r "いい？"
    r "哈？"

# game/script.rpy:947
translate zh_cn start_21ec28e1:

    # i "はは。\nやっぱり、いきなりは\n無理だな。"
    i "嗨，果然一下子适应不了啊。"

# game/script.rpy:949
translate zh_cn start_326386c0:

    # r "無理ですよ。"
    r "当然啊。"

# game/script.rpy:951
translate zh_cn start_ab204809:

    # i "そうだね。"
    i "也是。"

# game/script.rpy:953
translate zh_cn start_28277e64_1:

    # r "…………"
    r "…………"

# game/script.rpy:958
translate zh_cn start_f1d4553e:

    # "厚い雲を透かして、\n夏の熱気が肌を射す。"
    "烈阳的炙热灼穿厚重的云层，\n夏日的气浪烧着我们的肌肤。"

# game/script.rpy:960
translate zh_cn start_e3f71f8a:

    # "潤はまだ、\nこの気候には慣れてないようだ。"
    "润似乎还没有适应这里的气候。"

# game/script.rpy:962
translate zh_cn start_3e7339c2:

    # "ときおりシャツをつまんでは\n風をおくっている。"
    "偶尔，她会为了吹风而卷起衬衫的袖子。"

# game/script.rpy:967
translate zh_cn start_22908fc6:

    # i "きのうは眠れた。"
    i "昨晚睡得如何？"

# game/script.rpy:972
translate zh_cn start_2bb3257d:

    # r "いちおうは……"
    r "还行吧……"

# game/script.rpy:974
translate zh_cn start_de811631:

    # r "あんまり、あたりが静かなんで、\n耳がキーンって鳴るかんじ……"
    r "但周围太安静了，\n总觉得耳朵里嗡嗡作响。"

# game/script.rpy:976
translate zh_cn start_112ad25f:

    # i "車も飛行機も\nちかくを通らないしね。"
    i "这附近没有汽车和飞机经过……"

# game/script.rpy:978
translate zh_cn start_045fce0e:

    # i "そのうち\nかじかが鳴きだしたら\nちょうどよくなるさ。"
    i "不过过几天就没这事了，\n「咕咕嘎嘎」要开始叫了。"

# game/script.rpy:980
translate zh_cn start_bb4081f3:

    # r "かじかって？"
    r "「咕咕嘎嘎」？"

# game/script.rpy:982
translate zh_cn start_007aaa51:

    # i "カエルだよ。"
    i "一种青蛙。"

# game/script.rpy:984
translate zh_cn start_07002d4b:

    # r "ケ、ケーロケロケロ……"
    r "嘎嘎嘎嘎嘎……？"

# game/script.rpy:986
translate zh_cn start_e3b3d7f4:

    # i "もっときれいに鳴くんだ。\nルルルルって。口笛みたいな。"
    i "它们的叫声更清脆，\n咕咕咕咕咕，\n像口哨一样。"

# game/script.rpy:988
translate zh_cn start_eff856fa:

    # r "へえ……妙なカエル。"
    r "诶……真是奇怪的青蛙。"

# game/script.rpy:990
translate zh_cn start_ed09f14b:

    # "昨晩のことに話を戻した。"
    "我们聊起了昨晚的事。"

# game/script.rpy:992
translate zh_cn start_f48cdf3f:

    # i "いちばん緊張して\n驚いてたのは、きみだったかな。"
    i "最紧张、最惊讶的那个应该是你吧。"

# game/script.rpy:997
translate zh_cn start_d4ac38f6:

    # r "先輩も\n知らなかったんですか？"
    r "前辈你当时也不知道吗？"

# game/script.rpy:999
translate zh_cn start_ad61daf4:

    # r "あたしが、先輩と、その、\n戸籍上の兄妹になる……ってこと。"
    r "我和前辈会成为户籍上的兄妹……这件事。"

# game/script.rpy:1001
translate zh_cn start_24c75ee2:

    # i "うん。\n昨日まで、ぜんぜん。"
    i "嗯，直到昨天我都完全不知道。"

# game/script.rpy:1006
translate zh_cn start_1081af82:

    # i "芳野さんの連れ子を紹介するって\n聞いていただけだ。"
    i "只是听说要介绍芳野阿姨的孩子。"

# game/script.rpy:1008
translate zh_cn start_b5563186:

    # i "それがまさか、\n古澤だとはね。"
    i "没想到会是你。"

# game/script.rpy:1010
translate zh_cn start_f990027f:

    # "がくっ、と潤は肩を落として\n言った。"
    "润垂下了肩膀。"

# game/script.rpy:1012
translate zh_cn start_bb8e181a:

    # r "だって……"
    r "因为……"

# game/script.rpy:1014
translate zh_cn start_e1fd2c7d:

    # r "マンガじゃないっすかー\nそんなの。"
    r "这简直和漫画里的情节一样。"

# game/script.rpy:1016
translate zh_cn start_ab204809_1:

    # i "そうだね。"
    i "确实。"

# game/script.rpy:1022
translate zh_cn start_be5f1967:

    # "憮然とする潤に、\n僕は肩をすくめた。"
    "看着一脸怅然的润，我耸了耸肩。"

# game/script.rpy:1024
translate zh_cn start_539ea285:

    # "セミの声にあらわれながら\nしばらく、ふたり廃線を進んだ。"
    "在蝉鸣的包围中，\n我们沿着旧铁道缓缓前行。"

# game/script.rpy:1026
translate zh_cn start_82e1ef1c:

    # "ここは通学路になる、\nと教えようとしながら、\n気にかかっていたことが頭に浮かんだ。"
    "本想告诉她这是上学的必经之路，\n但我的思绪却被另一件事占据。"

# game/script.rpy:1028
translate zh_cn start_cebd9a8e:

    # i "怒ってないか。"
    i "你没有生气吗？"

# game/script.rpy:1030
translate zh_cn start_fc14c59e:

    # r "……え？　なにが。"
    r "……诶？　生什么气？"

# game/script.rpy:1032
translate zh_cn start_5a6cc860:

    # i "……樹里はさ、\nいかにも聞いたふうで\n生意気だろ。"
    i "……因为树里确实有些傲慢。"

# game/script.rpy:1034
translate zh_cn start_3ff09a7f:

    # i "ムカついてるんじゃないか。\n年下なのに。"
    i "你会不会因此生气呢？\n毕竟她年龄比你小。"

# game/script.rpy:1039
translate zh_cn start_8a1916bf:

    # r "……あの子を置いて、\nあたしを連れ出したのって\nそれですか？"
    r "……你就是因为这个才把她丢下，\n只带我两个人出来的吗？"

# game/script.rpy:1041
translate zh_cn start_429ab962:

    # "僕をじろりとにらむと、\n潤はふうと息をついて、\n肩から力を抜いた。"
    "润瞪了我一眼，随后叹气垮肩。"

# game/script.rpy:1046
translate zh_cn start_97241365:

    # r "別に愚痴ったりなんて\n無いですよ。"
    r "我没抱怨，也没什么好抱怨。"

# game/script.rpy:1048
translate zh_cn start_7f4b3349:

    # r "そんなのわかってて、\nママについてきたんだし。"
    r "毕竟我也是在了解这些后，\n才决定跟着妈妈的。"

# game/script.rpy:1053
translate zh_cn start_afbdd8da:

    # r "まあ……あんな……\n超アイドル系だなんて\n思わなかったけど……"
    r "不过……\n没想到树里会是那种\n超级偶像系的女生……"

# game/script.rpy:1055
translate zh_cn start_3f45798e:

    # "だいたい、\nどうしてあたしの周りは……\nと、ぶちぶちボヤく。"
    "「真是的，为什么我周围老有……」\n她低声嘟囔着。"

# game/script.rpy:1057
translate zh_cn start_3f33a62c:

    # i "遠慮することない。"
    i "不用勉强自己。"

# game/script.rpy:1059
translate zh_cn start_ce846564:

    # i "いやなことがあったら、\n僕でも、父さんでも言うんだ。"
    i "如果感到不爽，就告诉我或者老爸。"

# game/script.rpy:1061
translate zh_cn start_43a72ed5:

    # i "ムリはしないでさ。"
    i "没必要委屈自己。"

# game/script.rpy:1066
translate zh_cn start_1b9ab74f:

    # r "ムリしてませんよ！"
    r "我才不会委屈自己呢！"

# game/script.rpy:1068
translate zh_cn start_7661d74c:

    # r "せいせいしてるんだから……"
    r "那我就放心了。"

# game/script.rpy:1070
translate zh_cn start_076626b2:

    # "つんと、空を向く潤は\n晴れやかな顔をしていた。"
    "润仰起头，对着天空露出了开朗的笑容。"

# game/script.rpy:1076
translate zh_cn start_89cc550a:

    # "駅前を抜けて、\nつらつらと続く坂道をのぼっていく。"
    "穿过车站后，信步踏上绵长的坡道。"

# game/script.rpy:1078
translate zh_cn start_3b4c8b2b:

    # "やがて、\n柿渋が塗られ、黒ずむ木造の屋敷の\nならぶ旧市街が姿をあらわした。"
    "不多时，旧城街巷缓缓铺展于眼前——\n木造老宅鳞次栉比，涂的柿漆色泽沉黯。"

# game/script.rpy:1080
translate zh_cn start_ac70da0a:

    # "首にじっとりと汗がにじみだしてくる。"
    "汗水顺着脖子流下。"

# game/script.rpy:1082
translate zh_cn start_84491e6a:

    # "潤もまた、汗を浮かべながらも\nふしぎそうに首をめぐらせ、\n町並みを見渡していた。"
    "润也满头大汗，但却没失去好奇。\n她四处地张望，将街景一一收入眼底。"

# game/script.rpy:1084
translate zh_cn start_2f9fc8d2:

    # "とうかんもり。"
    "稻荷森。"

# game/script.rpy:1086
translate zh_cn start_7b53e292:

    # "───日々刻々と\nうつりゆく季節を呼吸しながら、\nなにも変わらない場所。"
    "——于年日流转中吞吐四季，\n却仿佛从未改变的地方。"

# game/script.rpy:1093
translate zh_cn start_0cbfac5b:

    # r "そういえば。"
    r "话说……"

# game/script.rpy:1095
translate zh_cn start_e2db7faf:

    # r "家で買い物、\n頼まれてましたよね。\n乾物屋さんでしたっけ？"
    r "家里让我顺路买东西来着，\n是要去干货店吧？"

# game/script.rpy:1097
translate zh_cn start_59833b4c:

    # r "あっちの表通りの方ですか？\n行きましょうよ。"
    r "是那边的大路吗？\n走吧。"

# game/script.rpy:1099
translate zh_cn start_ad6c310d:

    # i "あ、ちょっと。"
    i "啊，等等。"

# game/script.rpy:1101
translate zh_cn start_810d843f:

    # i "あいかわらず、\n手際よく運ぼうと\nするなあ。"
    i "你还是一如既往地闲不住，\n总想把事情一口气做完啊。"

# game/script.rpy:1103
translate zh_cn start_db40e269:

    # r "どうせ、せっかちですから。"
    r "反、反正我就是急性子。"

# game/script.rpy:1105
translate zh_cn start_806455d6:

    # i "別にいいよ、今日は。\nバイト中じゃない。"
    i "别那么急，给家里买东西又不是上班。"

# game/script.rpy:1107
translate zh_cn start_53c6be60:

    # i "潤を案内に来たんだ。\n買い物はあとで。"
    i "再说我还要给你介绍稻荷森呢，\n等会儿再去买东西吧。"

# game/script.rpy:1109
translate zh_cn start_7d68988b:

    # r "……うーん、ですか？"
    r "……嗯，好吧。"

# game/script.rpy:1111
translate zh_cn start_1124fbf6:

    # "しぶしぶまわれ右して、\n散策コースへもどる。"
    "她不情愿地转向右边，\n回到了散步的路线。"

# game/script.rpy:1113
translate zh_cn start_1fcbf6b2:

    # i "おもしろいとこだろ。\nこの町。"
    i "这个城镇很有趣吧。"

# game/script.rpy:1115
translate zh_cn start_5feecc2e:

    # i "階段や坂道ばかりで、\nのぼり降りが大変だけど。"
    i "虽然有很多台阶和坡道，\n走路会有点累。"

# game/script.rpy:1117
translate zh_cn start_e099a04f:

    # r "はあ……"
    r "啊哈……"

# game/script.rpy:1119
translate zh_cn start_b7daed97:

    # r "これが毎日じゃ、面白いなんて\n言ってられないと思うけど……"
    r "感觉如果每天都这样，\n可能就不会觉得有趣了……"

# game/script.rpy:1121
translate zh_cn start_5b7cf848:

    # "色あせた光景のそこかしこには、\n僕の少年時代がしみついている。"
    "褪色的光景中，\n处处微渗着我少年时代的回忆。"

# game/script.rpy:1123
translate zh_cn start_ca540ad2:

    # "道をたどりながら、\nいろいろなことを\n話して聞かせた。"
    "我们就这样走着，\n那些往事，\n我借之一件件说给她听。"

# game/script.rpy:1125
translate zh_cn start_0d2cc353:

    # "潤は、おとなしく相づちを打ち\n耳をかたむけていたが、\nやがてぽつりと言った。"
    "润也就这样静静听着，\n过了好一会儿，她低喃道。"

# game/script.rpy:1127
translate zh_cn start_1453661a:

    # r "…………ず……"
    r "…………"

# game/script.rpy:1129
translate zh_cn start_e401f433:

    # r "ずるい。"
    r "狡猾。"

# game/script.rpy:1134
translate zh_cn start_33bcd34c:

    # "唇を噛んで\nうつむく。"
    "她咬着嘴唇，低下了头。"

# game/script.rpy:1136
translate zh_cn start_be40e08f:

    # i "……え？"
    i "……诶？"

# game/script.rpy:1138
translate zh_cn start_0a9e82a1:

    # r "ずるいよ。"
    r "太狡猾了。"

# game/script.rpy:1140
translate zh_cn start_4ff9e98d:

    # r "先輩ばっかり、\nそんな簡単に───"
    r "前辈不要这么简简单单——"

# game/script.rpy:1142
translate zh_cn start_d5aac4f2:

    # r "ここにあたしがいるの、\n当たり前みたいに。"
    r "觉得我在这里是理所当然的。"

# game/script.rpy:1147
translate zh_cn start_bb7979aa:

    # "そうして潤は、\n枯尾沼を見おろす\n懸崖を向いた。"
    "润俯视着枯尾沼，面朝悬崖。"

# game/script.rpy:1154
translate zh_cn start_ac55acf3:

    # r "ずるいよ……"
    r "太狡猾了……"

# game/script.rpy:1156
translate zh_cn start_54c14b89:

    # "赤く染まった横顔を\n淡い色の髪がなでる。"
    "淡色的头发轻抚着被夕阳染红的脸颊。"

# game/script.rpy:1158
translate zh_cn start_0386dc64_1:

    # i "…………"
    i "…………"

# game/script.rpy:1160
translate zh_cn start_c120ad77:

    # "潤のいらだちは\n当然だ。"
    "润的烦躁是理所当然的。"

# game/script.rpy:1162
translate zh_cn start_1e19cbac:

    # "熱心につとめていたバイトを辞めて、\n引っ越すことになったと聞かされ……"
    "当时润辞去了喜欢的兼职工作，\n听她说要决定搬家……"

# game/script.rpy:1164
translate zh_cn start_7ab0364c:

    # "せめて見送ろうとした最後の夜、\n潤は泣いた。"
    "在我目送她离开的那一晚，\n润哭了。"

# game/script.rpy:1166
translate zh_cn start_d067c631:

    # "あんなふうに平静を失くした彼女を\nはじめて見た。"
    "我第一次见到她如此失态。"

# game/script.rpy:1168
translate zh_cn start_c802cd86:

    # "落ち着かせようとする\n僕の腕をふりはらって、\nわめき散らし、非難した。"
    "我试图安慰她，\n但她推开我的手臂，\n大声责难。"

# game/script.rpy:1170
translate zh_cn start_b1b73007:

    # "結局は、\n満足な言葉も交わせずに\n僕らは別れた。"
    "最终，\n我们没有再多说什么，\n就这样分别了。"

# game/script.rpy:1172
translate zh_cn start_6c992118:

    # "それが\nひとつきほど前のこと。"
    "那是大约一个月前的事。"

# game/script.rpy:1174
translate zh_cn start_0820ed67:

    # "よりによって\nこんな意地の悪い\n偶然が待っていたとは。"
    "没想到，\n命运会以如此巧合的方式，\n让我们重逢。"

# game/script.rpy:1179
translate zh_cn start_ccc650af:

    # r "う……\nごめん……なさい……"
    r "呜……对、对不起…………"

# game/script.rpy:1181
translate zh_cn start_e221b75b:

    # "反省のはやい\n潤が首をたれる。"
    "润低下头，声音中带着悔意。"

# game/script.rpy:1183
translate zh_cn start_b9958186:

    # r "あの時、あたし……\nメチャクチャだったから。"
    r "那时候，我的脑子一片混乱……"

# game/script.rpy:1185
translate zh_cn start_8a35084f:

    # r "先輩に、ひどいこと、\n言っちゃって。"
    r "然后……\n对前辈说了过分的话……"

# game/script.rpy:1187
translate zh_cn start_965a29f6:

    # i "べつに気にしてや……"
    i "我没放在心上。"

# game/script.rpy:1192
translate zh_cn start_159287a7:

    # r "し、知ってますって、\nそんなの。"
    r "我、我知道前辈你不会介意的。"

# game/script.rpy:1194
translate zh_cn start_630fdf4c:

    # "潤は自嘲の笑いを浮かべる。"
    "润露出自嘲的笑容。"

# game/script.rpy:1196
translate zh_cn start_07af1a30:

    # r "先輩、いい人だから。\n知ってます。"
    r "我知道前辈是个善良的人。"

# game/script.rpy:1198
translate zh_cn start_a244cbcc:

    # "背伸びをしながら\n潤は顔をそむけた。"
    "润伸了伸腰，转过头去。"

# game/script.rpy:1203
translate zh_cn start_2cd9522d:

    # "胸をそらし\n伸ばした腕で\nガードレールをつかむ。"
    "她挺起胸脯，双手握住护栏。"

# game/script.rpy:1205
translate zh_cn start_944d6e9a:

    # r "……あたしのが\n自分に酔ってたんですよー。"
    r "……是我沉浸在自己的世界里了。"

# game/script.rpy:1207
translate zh_cn start_f250fd1f:

    # r "おっと、これって悲劇の\nヒロインみたいだなー\n……って。"
    r "当时满脑子胡思乱想，\n什么悲剧的女主角啊……之类的。"

# game/script.rpy:1209
translate zh_cn start_1a78200d:

    # r "ちょっと\nいいシーンかもって……\nヘヘ……"
    r "其实也可能是美好的一幕嘛…………\n哈哈……"

# game/script.rpy:1211
translate zh_cn start_0386dc64_2:

    # i "…………"
    i "…………"

# game/script.rpy:1216
translate zh_cn start_2467002a:

    # r "今度のだって、\n新しい家族とか、兄妹とか、\nそんなんじゃなくてですね……"
    r "说是美好，\n也不是因为有了新的家人、兄妹什么的……"

# game/script.rpy:1218
translate zh_cn start_d51a0fe3:

    # r "ただ、新しい逃げ場所が\n見つかったって\nだけなんですよ。"
    r "而是说找到了一个新的逃避的地方。"

# game/script.rpy:1220
translate zh_cn start_a29eb1f7:

    # r "ママとあたしみたいな、\n世間に養ってもらってるのは……"
    r "像妈妈和我这样的，\n全靠社会养活的人……"

# game/script.rpy:1222
translate zh_cn start_962a792b:

    # r "屋根があるだけ、\nマシってもんです。"
    r "如今能有房子住，\n已经是很不错了。"

# game/script.rpy:1224
translate zh_cn start_0386dc64_3:

    # i "…………"
    i "…………"

# game/script.rpy:1226
translate zh_cn start_a88d2d0d:

    # "潤らしくない、\n卑下した口ぶりに\nしずかに言い添える。"
    "听到润那与以往不同的自卑语气，\n我平静地插口道。"

# game/script.rpy:1231
translate zh_cn start_4391d41d:

    # i "……きみの母さんは、\nそんな卑屈には\n思ってないんじゃないかな。"
    i "……你妈妈应该不会这么妄自菲薄吧。"

# game/script.rpy:1236
translate zh_cn start_208fd1e9:

    # "潤はにがい表情で\n町を見おろしたまま\n聞いていた。"
    "润一脸苦涩，边看着城镇边听着。"

# game/script.rpy:1238
translate zh_cn start_ef5e80eb:

    # i "芳野さんの支えがなければ\nうちは、どうなっていたか\nわからないし。"
    i "如果没有芳野阿姨的支持，\n我们家可能早就撑不下去了。"

# game/script.rpy:1240
translate zh_cn start_6610cc00:

    # i "病弱だった樹里が、\n人並みに健康になれたのも。"
    i "曾体弱多病的树里能像常人一样健康，"

# game/script.rpy:1242
translate zh_cn start_54486de1:

    # i "僕が、この町を離れて\n進学できたのも。"
    i "我能够离开这个小镇考上大学，"

# game/script.rpy:1244
translate zh_cn start_4df264b8:

    # i "芳野さんが\nそばにいてくれたからだ。"
    i "都是因为芳野阿姨在身边。"

# game/script.rpy:1246
translate zh_cn start_1fe4235f:

    # i "なにより、\n父さんを支えてくれたんだ。"
    i "最重要的是，\n她是我的父亲的特别的依靠。"

# game/script.rpy:1248
translate zh_cn start_7ebaf678:

    # "はるか枯尾沼へ視線を落とす。"
    "我的目光落在远处的枯尾沼上。"

# game/script.rpy:1250
translate zh_cn start_8e1c780b:

    # "ここからは、我が家は\n山の稜線に隠れてしまっている。"
    "从这里望去，\n我们的家被山脊遮住了。"

# game/script.rpy:1252
translate zh_cn start_cec1b1c2:

    # i "目が見えないせいで\nかよわく見られもするけど……\n本当はずっと、心の強い人だよ。"
    i "虽然她眼睛看不见，\n可能会让人觉得她柔弱，\n但其实她一直都很坚强。"

# game/script.rpy:1254
translate zh_cn start_bc998be7:

    # i "僕より、きみのほうが\nわかってるはずだ。"
    i "这点你应该比我更清楚。"

# game/script.rpy:1256
translate zh_cn start_a071eaca:

    # i "結局、家をあけることも\n多かったろうけれど、\nきみ、それ恨んでるかい？"
    i "不过她常不在家，\n你是对这点感到不满吗？"

# game/script.rpy:1258
translate zh_cn start_c6ef30e1:

    # i "放って置かれたって\n思っているかい。"
    i "是觉得她忽略了你吗？"

# game/script.rpy:1263
translate zh_cn start_28277e64_2:

    # r "…………"
    r "…………"

# game/script.rpy:1265
translate zh_cn start_8eb3c34b:

    # "潤は黙ったまま\n首を振った。"
    "润默默地摇了摇头。"

# game/script.rpy:1267
translate zh_cn start_edf0fd82:

    # "脇の柵に\n自分も寄りかかる。"
    "我靠在旁边的栏杆上。"

# game/script.rpy:1273
translate zh_cn start_c334c366:

    # i "古澤。"
    i "古泽。"

# game/script.rpy:1275
translate zh_cn start_21926e1e:

    # "ついそう呼んでしまったが\nそのまま続けた。"
    "虽然一不小心用了这个称呼，\n但我还是继续说了下去。"

# game/script.rpy:1277
translate zh_cn start_28277e64_3:

    # r "…………"
    r "…………"

# game/script.rpy:1279
translate zh_cn start_3135a5ee:

    # i "きみさえよけりゃ\nだけどさ。"
    i "虽然只要你觉得呆在这里挺好的就行。"

# game/script.rpy:1284
translate zh_cn start_bc54794f:

    # r "う……うい？"
    r "呃……嗯？"

# game/script.rpy:1286
translate zh_cn start_de950f50:

    # i "もし、本当に\nこの町が嫌だったら\n東京へ来るかい？"
    i "但如果你不喜欢这个城镇的话，\n去东京怎么样？"

# game/script.rpy:1291
translate zh_cn start_5864f4e4:

    # r "え……"
    r "哈啊？"

# game/script.rpy:1293
translate zh_cn start_35aaaf1a:

    # "潤は目を白黒させる。"
    "润瞪大的眼珠子显得黑白分明。"

# game/script.rpy:1295
translate zh_cn start_35193d8f:

    # r "な、なに言ってんですか？"
    r "前、前辈，你在说什么！？"

# game/script.rpy:1297
translate zh_cn start_26b1039e:

    # i "まじめな話だよ。"
    i "我认真的。"

# game/script.rpy:1299
translate zh_cn start_d9010ecb:

    # i "いずれ自立する助けくらいなら\n僕にもできる。"
    i "反正你也就只是需要人来帮忙照顾，\n那我也行啊。"

# game/script.rpy:1301
translate zh_cn start_bc0cae45:

    # i "進学は、今年度はまあ、無理かな。\nひとまず浪人だ。"
    i "升学的话，今年可能来不及了，\n那就暂时当个失学学生吧。"

# game/script.rpy:1303
translate zh_cn start_ddb6f2c1:

    # i "ひとり暮らしできるまで\n僕のアパートを使っていい。"
    i "直到能独立生活那天为止，\n你可以先住在我的公寓。"

# game/script.rpy:1305
translate zh_cn start_b2409aad:

    # r "って、先輩は！？"
    r "那、那前辈呢！？"

# game/script.rpy:1307
translate zh_cn start_55effa5d:

    # i "もちろん一緒に住むよ。"
    i "当然也住在一起啊。"

# game/script.rpy:1312
translate zh_cn start_ee7e7206:

    # r "そ、それっ、同棲じゃないですか。"
    r "那、那、那不就是同居了吗！？"

# game/script.rpy:1314
translate zh_cn start_cf3c1b10:

    # i "でも兄妹だろ。"
    i "我们是兄妹啊。"

# game/script.rpy:1316
translate zh_cn start_2bf48e3e:

    # r "そんなっ、都合のいい！"
    r "不要用家人关系来回避我的问题啦！"

# game/script.rpy:1318
translate zh_cn start_e351bbe0:

    # r "ちょ、ちょっと待って。"
    r "不对，等、等等——"

# game/script.rpy:1323
translate zh_cn start_007ebaa1:

    # "潤は両の手のひらを\nぐっと差し出した。"
    "润猛地伸出双手拒绝着。"

# game/script.rpy:1325
translate zh_cn start_cd929659:

    # r "だめ、\nだめですよ。"
    r "不，不行。"

# game/script.rpy:1330
translate zh_cn start_a4ab38f5:

    # r "……だって先輩は、\n好きな人が、いるんでしょう！？"
    r "……前辈有喜欢的人吧！？"

# game/script.rpy:1332
translate zh_cn start_6093aae0:

    # "おもわず面くらった僕をみて\n潤は確信したらしい。"
    "看到我有些慌乱的样子，\n润似乎确信了这一点。"

# game/script.rpy:1337
translate zh_cn start_7da98b2f:

    # r "……お店に来てた先輩の友だちが、\n話してるの、聞いちゃったんです。"
    r "我在店里听前辈的朋友们说的……"

# game/script.rpy:1339
translate zh_cn start_f75e64c1:

    # r "相手のひとは知りませんよ。\n見たこともないです。"
    r "我不知道对方是谁，也没见过。"

# game/script.rpy:1341
translate zh_cn start_830a63f9:

    # r "でも、だったら……\n先輩の厄介になんか\nなれっこありません。"
    r "但，如果真是这样的话……\n我不想成为前辈的负担。"

# game/script.rpy:1346
translate zh_cn start_93e89570:

    # r "でしょ？"
    r "前辈？"

# game/script.rpy:1348
translate zh_cn start_0386dc64_4:

    # i "…………"
    i "哎…………"

# game/script.rpy:1350
translate zh_cn start_7b05e631:

    # "勝手にため息が出た。"
    "我不由自主地叹了口气。"

# game/script.rpy:1352
translate zh_cn start_f7377079:

    # i "その人には\n交際を断られたよ。"
    i "她已经拒绝了我的表白。"

# game/script.rpy:1354
translate zh_cn start_fd1e1f56:

    # i "ずいぶん、はっきりと。"
    i "而且说得很干脆。"

# game/script.rpy:1359
translate zh_cn start_5d16d235:

    # r "……へっ"
    r "……诶？"

# game/script.rpy:1361
translate zh_cn start_8e3654dd:

    # "潤は、なんともいえぬ\n微妙な表情で固まった。"
    "润露出一副微妙的表情，僵住了。"

# game/script.rpy:1363
translate zh_cn start_e8b7d3c4:

    # r "……………………マ……"
    r "……………………真……"

# game/script.rpy:1365
translate zh_cn start_89e14437:

    # r "マジですか？"
    r "真的吗？"

# game/script.rpy:1367
translate zh_cn start_b14ad561:

    # i "マジ。"
    i "不骗你。"

# game/script.rpy:1372
translate zh_cn start_16d264dd:

    # r "…………ひ、ひどっ……"
    r "…………好、好过分……"

# game/script.rpy:1374
translate zh_cn start_d1a3f0ce:

    # r "ほんとに\n人間なんですか？　その人？"
    r "她真的是人类吗？\n竟然拒绝了前辈？　她以为她谁啊？"

# game/script.rpy:1376
translate zh_cn start_949cc103:

    # "まくしたてる潤に\n照れ隠しするように告げた。"
    "面对喋喋不休的润，\n我为了掩饰羞涩开口道。"

# game/script.rpy:1382
translate zh_cn start_383c5bcd:

    # i "こっちのことは\n気にするなよ。"
    i "别在意我啦。"

# game/script.rpy:1384
translate zh_cn start_6f589b85:

    # i "今すぐ決めなくたっていいんだ。"
    i "搬去东京这事你也不用急着决定。"

# game/script.rpy:1386
translate zh_cn start_7d6c4452:

    # i "そういう方法もある、\nってことだから。"
    i "我只是给你一个可行的方案而已。"

# game/script.rpy:1388
translate zh_cn start_9801542e:

    # i "しばらく\n考えてみてくれ。"
    i "你先考虑考虑。"

# game/script.rpy:1394
translate zh_cn start_97f9e021:

    # r "…………はい。"
    r "…………嗯。"

# game/script.rpy:1396
translate zh_cn start_9c7010fb:

    # "今は、そう返事をするのが\nやっとらしい。"
    "她现在也只能这样回应了。"

# game/script.rpy:1399
translate zh_cn start_afee9a72:

    # "ふう、と息をつくと\n急に崖の放水口の音が\n戻ってきた。"
    "歇了一口气后，\n突然听到悬崖喷水口的声音。"

# game/script.rpy:1408
translate zh_cn start_d152711f:

    # i "喉かわいたろ？"
    i "你渴了吧？"

# game/script.rpy:1411
translate zh_cn start_4f8c6c5d:

    # i "買い物ついでに\n自販機に寄ってこようか。"
    i "买东西时顺道去一下自动贩卖机吧。"

# game/script.rpy:1413
translate zh_cn start_6313c4b4:

    # r "はい。"
    r "嗯。"

# game/script.rpy:1415
translate zh_cn start_575a1222:

    # i "ああ、きみはいいよ。\n日陰で休んでるといい。"
    i "啊，你可以不用跟来，\n在树荫下休息就好。"

# game/script.rpy:1417
translate zh_cn start_94a9dda8:

    # r "じゃ、あたしコーラで。"
    r "那我要喝可乐。"

# game/script.rpy:1419
translate zh_cn start_7695c1ff:

    # i "そんなのないよ。\nこぶ茶か、ラムネか……"
    i "没有可乐。\n只有海带茶，或者是柠檬水……"

# game/script.rpy:1421
translate zh_cn start_9e7c49ac:

    # r "えっ！？\n無いんですか？"
    r "诶！？\n竟然没有可乐？"

# game/script.rpy:1423
translate zh_cn start_f680f461:

    # i "冗談。"
    i "开玩笑的。"

# game/script.rpy:1425
translate zh_cn start_30d709fd:

    # i "オッケー。\nちょっと待ってて。"
    i "ＯＫ，等我一会儿。"

# game/script.rpy:1430
translate zh_cn start_28277e64_4:

    # r "…………"
    r "…………"

# game/script.rpy:1432
translate zh_cn start_bc531c38:

    # r "………………ふぅ……"
    r "………………呼……"

# game/script.rpy:1434
translate zh_cn start_9be7d09c:

    # r "……先輩と……"
    r "……和前辈……"

# game/script.rpy:1436
translate zh_cn start_28277e64_5:

    # r "…………"
    r "…………"

# game/script.rpy:1440
translate zh_cn start_c604ebfb:

    # r "……一緒に？"
    r "……住一起？"

# game/script.rpy:1442
translate zh_cn start_0e4f3f4b:

    # r "………………"
    r "………………"

# game/script.rpy:1445
translate zh_cn start_aa533297:

    # r "………………？"
    r "………………？"

# game/script.rpy:1449
translate zh_cn start_28277e64_6:

    # r "…………"
    r "…………"

# game/script.rpy:1452
translate zh_cn start_03098791:

    # r "………樹里………？"
    r "…………树里……？"

# game/script.rpy:1455
translate zh_cn start_d21fda0d:

    # r "ついて……来たの？"
    r "你是……跟过来了吗？"

# game/script.rpy:1460
translate zh_cn start_d37be59c:

    # r "…………樹……"
    r "…………树……"

# game/script.rpy:1465
translate zh_cn start_27b61ebb:

    # r "…………だれ……"
    r "…………是谁……"

# game/script.rpy:1561
translate zh_cn start_4115d077:

    # r "樹里だろ……"
    r "是树里吧……"

# game/script.rpy:1563
translate zh_cn start_631589d3:

    # r "悪ふざけ、\nやめろって。"
    r "别搞恶作剧了。"

# game/script.rpy:1568
translate zh_cn start_703a3e51:

    # r "…………樹里っ……"
    r "…………树里……"

# game/script.rpy:1570
translate zh_cn start_0e4f3f4b_1:

    # r "………………"
    r "………………"

# game/script.rpy:1572
translate zh_cn start_741869ee:

    # r "……先輩……"
    r "……前辈……"

# game/script.rpy:1577
translate zh_cn start_177952ef:

    # r "…………先輩……っ……！"
    r "…………前辈———！"

# game/script.rpy:1582
translate zh_cn start_6ab24882:

    # r "…………！？"
    r "…………！？"

# game/script.rpy:1587
translate zh_cn start_ef8ae8e3:

    # n "どうしました？\nお探しものですか？"
    n "怎么了？\n你在找什么东西吗？"

# game/script.rpy:1596
translate zh_cn start_dfe4316c:

    # r "あ、いえ。"
    r "啊，不是……"

# game/script.rpy:1598
translate zh_cn start_738705fc:

    # n "ん～？\n…………あっ！"
    n "嗯～？\n…………啊！"

# game/script.rpy:1606
translate zh_cn start_8c7734d0:

    # n "ちょっと待って\nピンと来た、\nいまサーチするから。"
    n "等等，我好像想起来了，\n让我搜索一下记忆。"

# game/script.rpy:1608
translate zh_cn start_12b9b70d:

    # r "……え？"
    r "……诶？"

# game/script.rpy:1613
translate zh_cn start_378b6354:

    # n "ええ～と～～"
    n "那～个～"

# game/script.rpy:1620
translate zh_cn start_5a61f7dc:

    # n "そだ。もしかして、\n芳野さんの娘さん？\n潤ちゃんさん？"
    n "对了，莫非你是\n芳野阿姨的女儿？\n润酱小姐？"

# game/script.rpy:1629
translate zh_cn start_56913383:

    # r "ちゃんさん？"
    r "酱小姐？"

# game/script.rpy:1634
translate zh_cn start_6dd2de0f:

    # r "あ、はい。\nそうです。"
    r "啊，对，我是润。"

# game/script.rpy:1639
translate zh_cn start_43940cc1:

    # n "やっぱり！"
    n "果然！"

# game/script.rpy:1641
translate zh_cn start_148b44f4:

    # n "私、夏生。\n簸川夏生。"
    n "我是夏生，簸川夏生。"

# game/script.rpy:1643
translate zh_cn start_93f932c4:

    # r "簸川……"
    r "簸川……"

# game/script.rpy:1648
translate zh_cn start_00b51057:

    # n "ええ。\n役場につとめてるの。\nお話は伺ってるわ。"
    n "嗯嗯。\n我在镇政府工作，\n听说过你的事。"

# game/script.rpy:1650
translate zh_cn start_9b2a8140:

    # n "健昭さんは、私の叔父よ。"
    n "簸川健昭是我的叔父。"

# game/script.rpy:1655
translate zh_cn start_00165d56:

    # r "ええと……じゃあ、\n従姉妹になるんですね。"
    r "哦哦……\n那我就是您的堂妹吧。"

# game/script.rpy:1657
translate zh_cn start_38340867:

    # n "うん。そゆこと。\nよろしくね？"
    n "就是这样，请多关照哦。"

# game/script.rpy:1662
translate zh_cn start_b5e8e7f3:

    # n "……ところで、\n本当に迷子だったの？"
    n "……话说回来，你迷路了？"

# game/script.rpy:1667
translate zh_cn start_70bde50c:

    # r "……恥ずかしながら……"
    r "说来惭愧……"

# game/script.rpy:1669
translate zh_cn start_bea7f401:

    # n "あらま。"
    n "哎呀呀～"

# game/script.rpy:1686
translate zh_cn start_9f9ac827:

    # "芳野さん、潤、樹里。\n女性３人が厨房に立つ光景は\nなかなか華やかだった。"
    "芳野阿姨、润、树里。\n三位女性同时立于厨间，\n那光景着实惹眼。"

# game/script.rpy:1688
translate zh_cn start_bcd25b66:

    # "ふだん料理などに興味のない\n樹里までが、首を突っ込んでいる。"
    "就连素日对厨事漠不关心的树里，\n也探进头来。"

# game/script.rpy:1690
translate zh_cn start_af8e75c1:

    # "ＴＶで見た、\nうろおぼえのレシピに挑戦して\n大惨事になっているようだ。"
    "她凭自己依稀的记忆，\n挑战电视上瞥见的菜谱，\n结果酿成了大惨案。"

# game/script.rpy:1692
translate zh_cn start_e3524688:

    # "潤は、豚レバを揚げる芳野さんを\n手伝いながら、副菜のきんぴらや、\nひじきのあえものを用意している。"
    "润边帮炒猪肝的芳野阿姨打下手，\n边准备着作为副菜的牛蒡丝和凉拌羊栖菜。"

# game/script.rpy:1694
translate zh_cn start_a123f53a:

    # "彼女のきびきびと働くさまは\n気持ちがいい。"
    "她利落的身手瞧着便令人舒心。"

# game/script.rpy:1696
translate zh_cn start_293283e0:

    # "さらには、\n手元が狂ったり味見をするたび、\nこっそりとゴミ箱へ近づく樹里を、"
    "她还总能及时制止了失手的树里——\n每当树里手一抖或试味时，\n润都会悄悄挪向垃圾桶，"

# game/script.rpy:1698
translate zh_cn start_19002286:

    # "めざとくとどめ、\nなんとかリカバリーしていた。"
    "花一番功夫，\n再将厨房恢复和平。"

# game/script.rpy:1700
translate zh_cn start_706835f2:

    # "居間から見ると、なんだか\n反復横飛びのようだ。"
    "从客厅望去，\n简直像在反复横飞的运动员。"

# game/script.rpy:1704
translate zh_cn start_8f601657:

    # "にぎやかなまま夕食を終え、\nしばらくして───"
    "热闹的晚餐结束后，\n过了一段时间——"

# game/script.rpy:1706
translate zh_cn start_2361cc17:

    # "すでに先客がいた風呂場から、\n吹き抜けへ、とってかえす。"
    "我走到通风口，\n发觉浴室已经有人用着了，\n遂欲折返。"

# game/script.rpy:1708
translate zh_cn start_3097c2fd:

    # "と、頭の上の踊り場から\n声がかかった。"
    "这时，\n听到了头上楼梯平台那儿传来的声音。"

# game/script.rpy:1712
translate zh_cn start_1c2d67c2:

    # y "健昭さん、\n本家へ向かわれたわ。"
    y "健昭他去了本家。"

# game/script.rpy:1714
translate zh_cn start_ad308877:

    # y "お祭りのことで\n相談があるんですって。"
    y "因为要商量关于祭典的事。"

# game/script.rpy:1716
translate zh_cn start_8bba6e32:

    # y "……五樹でしょう？"
    y "……是五树吧？"

# game/script.rpy:1718
translate zh_cn start_668fd614:

    # i "そうだよ。"
    i "是我。"

# game/script.rpy:1720
translate zh_cn start_b7ace899:

    # "芳野さんは、\n手すりをつたいながら、\n危なげなく階下へ降りた。"
    "芳野阿姨扶着扶手，\n稳稳当当地下着楼梯。"

# game/script.rpy:1726
translate zh_cn start_8f49acf1:

    # y "明後日には、やはり\n帰ってしまうの？"
    y "果然会在后天回去吗？"

# game/script.rpy:1728
translate zh_cn start_5ebdde56:

    # i "……ごめん。"
    i "……抱歉。"

# game/script.rpy:1732
translate zh_cn start_8d29222a:

    # y "いいのよ。\n忙しいのでしょう。"
    y "没关系啦，毕竟你很忙吧。"

# game/script.rpy:1734
translate zh_cn start_5a434f61:

    # y "それで、よかったら\n話したいことがあるの。"
    y "然后，如果可以的话，想跟你说件事。"

# game/script.rpy:1736
translate zh_cn start_9e62e227:

    # i "じゃあ居間で。\n麦茶でもいれるから。"
    i "那就到客厅说吧，我去沏大麦茶。"

# game/script.rpy:1738
translate zh_cn start_cdf997b5:

    # "芳野さんは首を振った。"
    "芳野阿姨摇了摇头。"

# game/script.rpy:1742
translate zh_cn start_d055caa9:

    # y "この場所でいいわ。"
    y "在这儿说就行了。"

# game/script.rpy:1744
translate zh_cn start_ba915853:

    # y "風がここちよいもの。"
    y "因为风吹得很舒服。"

# game/script.rpy:1746
translate zh_cn start_68168899:

    # i "そう。"
    i "是嘛。"

# game/script.rpy:1748
translate zh_cn start_aa9d7d4d:

    # "階段にかけた芳野さんの横に、\n僕もおずおずと腰をすえた。"
    "在坐着台阶上的芳野阿姨旁边，\n我也怯生生地坐下了。"

# game/script.rpy:1755
translate zh_cn start_e4e0343b:

    # y "いい機会だから、\nはなしておきたいの。"
    y "我想现在是跟你说这些话的好机会。"

# game/script.rpy:1757
translate zh_cn start_51247ee3:

    # y "五樹は、きっと自分からは\n尋ねてくれないと思うから。"
    y "因为感觉五树自己一定是不会来问我的。"

# game/script.rpy:1759
translate zh_cn start_cb76e3ae:

    # "すこし異なる雰囲気の芳野さんが、\n無防備に自分を見せる。"
    "氛围稍微有些变化，\n芳野阿姨将自己毫无防备的一面展露出来。"

# game/script.rpy:1761
translate zh_cn start_34e72ef2:

    # y "もう、潤とは、\n知り合いだったのね。"
    y "在这几天前你就已经和润熟识了吧。"

# game/script.rpy:1763
translate zh_cn start_82d88209:

    # i "うん。\n偶然だったんだけど。\nバイト先で。"
    i "嗯，偶然在打工场所结识的。"

# game/script.rpy:1765
translate zh_cn start_648a4af1:

    # y "……そう。"
    y "……是嘛。"

# game/script.rpy:1767
translate zh_cn start_af8835fa:

    # y "五樹のことをね、どうして先に\n教えてくれなかったんだって───"
    y "她说啊：「为什么没有早点把五树的事情告诉我呢？」"

# game/script.rpy:1769
translate zh_cn start_30af9201:

    # y "潤にはずいぶん\n怒られてしまって……"
    y "……润生气了……"

# game/script.rpy:1771
translate zh_cn start_a5c584ca:

    # y "反省しております。"
    y "我有在反省。"

# game/script.rpy:1773
translate zh_cn start_361a7bdc:

    # "ぺこりと頭をたれる。"
    "她低下头。"

# game/script.rpy:1775
translate zh_cn start_f17ea409:

    # i "はは。"
    i "哈哈。"

# game/script.rpy:1777
translate zh_cn start_87c14156:

    # y "ふふっ。\nでも、なぜかしら。"
    y "呵呵……不过，不知道为什么。"

# game/script.rpy:1779
translate zh_cn start_3afa2260:

    # y "潤と五樹は、\n大丈夫だって気がしていたの。"
    y "感觉润和五树……\n你们之间肯定没问题的。"

# game/script.rpy:1781
translate zh_cn start_bbaebfc4:

    # "芳野さんは\nすっと顔をあげて\n遠くを見た。"
    "芳野阿姨突然抬头看向远方。"

# game/script.rpy:1783
translate zh_cn start_ee6c018f:

    # y "潤の父親はね、桐生秀人という名の、\n有名な建築家よ。"
    y "润的父亲是一位叫桐生秀人的著名建筑师哦。"

# game/script.rpy:1785
translate zh_cn start_f756fba8:

    # i "名前は知ってる。\nいちどなら会ったことある。"
    i "我知道这个名字，还跟他见过一次面。"

# game/script.rpy:1787
translate zh_cn start_6859066f:

    # y "そうね。\n健昭さんのお仕事先ですからね。"
    y "是呢，毕竟健昭也是在那里上班的。"

# game/script.rpy:1789
translate zh_cn start_cfaf09a5:

    # y "健昭さんと朱音さんが上京した時に、\nいろいろと世話をしてくれたのも、\nあの人。"
    y "健昭和朱音初来东京的时候，\n也是多亏桐生先生在各方面照顾了他们。"

# game/script.rpy:1791
translate zh_cn start_416361a9:

    # y "この家も\nあの人が造った……"
    y "就连这间屋子，也是他造的……"

# game/script.rpy:1793
translate zh_cn start_de164131:

    # "芳野さんは、階段の手すりに\n白い指をかける。"
    "芳野阿姨将白皙的手指搭在栏杆上。"

# game/script.rpy:1795
translate zh_cn start_c6b32c76:

    # i "じゃあ……\n桐生さんとは、離婚して……？"
    i "那……您跟桐生先生离婚了……？"

# game/script.rpy:1797
translate zh_cn start_1a72a581:

    # y "……いいえ。\n桐生氏には、ちゃんと妻子が\nいらっしゃるわ。"
    y "不是哦，桐生先生另有家室。"

# game/script.rpy:1799
translate zh_cn start_17229187:

    # y "愛人をしていたのよ、私。\nあの人の。"
    y "我之前是他的情人。"

# game/script.rpy:1801
translate zh_cn start_b375e82d:

    # y "未婚の母というわけ。\nだから、籍を入れたのは\n健昭さんがはじめて。"
    y "也就是未婚妈妈。\n这样说吧，健昭是我第一个结婚对象。"

# game/script.rpy:1803
translate zh_cn start_c01135f1:

    # y "ごめんなさい、こんな話で。"
    y "真不好意思啊，跟你说这些话。"

# game/script.rpy:1805
translate zh_cn start_77d8b089:

    # i "いや……\nすこし驚いたけど。\n平気だよ。"
    i "没……\n也就是有点吃惊而已，\n没关系的。"

# game/script.rpy:1811
translate zh_cn start_bfe8bf1f:

    # y "……ありがとう。"
    y "……谢谢。"

# game/script.rpy:1813
translate zh_cn start_f508ce18:

    # y "大人になったのね、五樹。"
    y "长大成人了呢，五树。"

# game/script.rpy:1815
translate zh_cn start_da42586c:

    # y "…………"
    y "…………"

# game/script.rpy:1817
translate zh_cn start_b22c54e7:

    # "思いを馳せる芳野さんの横顔は、\n記憶の中のそれより、\nすこし、やつれてみえた。"
    "思绪奔向过去的芳野阿姨的侧脸，\n与印象相比稍显憔悴。"

# game/script.rpy:1819
translate zh_cn start_8fa396da:

    # y "……健昭さんが、桐生氏の仕事場に\n出入りするようになって、\n時折、お話しするようになったわ。"
    y "……自从健昭开始在桐生先生的工作场所出入，\n我有时也会跟他说说话。"

# game/script.rpy:1821
translate zh_cn start_b6b82626:

    # y "それで、そのころ身重だった\n朱音さんのことを知ってね……"
    y "然后，也是在那时候\n认识了有孕在身的朱音……"

# game/script.rpy:1823
translate zh_cn start_9c90cd64:

    # y "こんな私でも、何か\nできることがないだろうか、\nって考えるようになった。"
    y "如此无用的我，居然突然开始想着\n自己能不能做些什么。"

# game/script.rpy:1825
translate zh_cn start_0595d0cb:

    # y "それまで、\nなんとなく生きてきた私が、\nほんのすこし、変わったの。"
    y "在那之前一直不知为何而活的我，\n稍微有些改变了。"

# game/script.rpy:1829
translate zh_cn start_8f224bc6:

    # y "それから健昭さんとは\nながいあいだ、友だちだったわ。"
    y "在那之后，我和健昭保持了很久的友好关系。"

# game/script.rpy:1831
translate zh_cn start_da42586c_1:

    # y "…………"
    y "…………"

# game/script.rpy:1835
translate zh_cn start_6c5ed250:

    # y "桐生氏は、きっと今でも、\n私を捨てたとは\n思っていないわ。"
    y "桐生先生肯定到现在\n都不认为自己把我舍弃了。"

# game/script.rpy:1837
translate zh_cn start_bb9ef422:

    # y "才気にあふれて、\nやる事はなんでも\nスケールが大きくて。"
    y "他才华横溢，所做之事都很宏大。"

# game/script.rpy:1839
translate zh_cn start_60650339:

    # y "無邪気で、\n人の驚くことばかり\n考えている人だから。"
    y "他是个单纯的，总是为别人着想的，\n做天马行空之事的人。"

# game/script.rpy:1841
translate zh_cn start_9c064634:

    # y "健昭さんは違うわね。"
    y "而健昭不一样。"

# game/script.rpy:1843
translate zh_cn start_fd7bc994:

    # y "健昭さんが、\n考えていることはいつも\n家族のことだった。"
    y "健昭每次想到的，都是关于家人的事情。"

# game/script.rpy:1845
translate zh_cn start_346791bd:

    # i "……そうかな。"
    i "……是吗。"

# game/script.rpy:1847
translate zh_cn start_e4b82daa:

    # i "撮影の仕事ばかりで\nほとんど家にはいなかった。"
    i "他总是忙着自己的摄影工作，几乎不在家。"

# game/script.rpy:1852
translate zh_cn start_16ce8b2d:

    # y "……健昭さんを恨んでる？　五樹。"
    y "……你是在埋怨健昭吗？　五树。"

# game/script.rpy:1854
translate zh_cn start_1ddf2499:

    # "それは奇しくも、\n潤に向けた問いと同じだった。"
    "没想到她竟然会提出，\n我向润提出的一样的问题。"

# game/script.rpy:1856
translate zh_cn start_e10dba65:

    # "僕は、自分自身の不安を、\n潤にぶつけていたんだと、\nそのとき、気づいた。"
    "这时我才意识到，\n自己先前是将自己的不安发泄在润上了。"

# game/script.rpy:1858
translate zh_cn start_0386dc64_5:

    # i "…………"
    i "…………"

# game/script.rpy:1860
translate zh_cn start_7bc3a1c7:

    # i "……いや……恨んでは\nいないと思う。"
    i "……不……我不怨他。"

# game/script.rpy:1862
translate zh_cn start_d26196e8:

    # i "……ただ……"
    i "……呃呃……"

# game/script.rpy:1864
translate zh_cn start_518b4a86:

    # i "……よくわからないんだ。\n父さんのことは。"
    i "……只是不太清楚父亲的事，不太了解他。"

# game/script.rpy:1866
translate zh_cn start_7b12f5dd:

    # y "……そういうものかも\nしれないわね。"
    y "……说不定父亲就是那样的存在吧。"

# game/script.rpy:1868
translate zh_cn start_f402fb9b:

    # y "年をとるにつれ、だんだんと\n父親を理解するように\nなっていくのかしら。"
    y "会不会，人越长大，越能懂得父亲呢？"

# game/script.rpy:1870
translate zh_cn start_0386dc64_6:

    # i "…………"
    i "…………"

# game/script.rpy:1872
translate zh_cn start_d314001b:

    # i "……芳野さんは\n僕らの面倒を押しつけられて\n迷惑じゃなかったの？"
    i "芳野阿姨不会感觉我们给你添麻烦了吗？"

# game/script.rpy:1877
translate zh_cn start_92fac36c:

    # y "苦労した、というなら\nもちろん大変だったけれど。"
    y "辛苦的话当然是很辛苦。"

# game/script.rpy:1882
translate zh_cn start_1d1beaef:

    # y "それが生き甲斐だったのだもの。\n健昭さんを助けながら、\nあなたたちの成長を見守ることが。"
    y "不过在帮衬健昭的同时关注着你们的成长，\n是我活下去的意义啊。"

# game/script.rpy:1884
translate zh_cn start_982ece61:

    # y "五樹と樹里が生まれて、\nずっと見続けてきた。"
    y "自从五树和树里出生之后，\n我一直都看在眼里。"

# game/script.rpy:1886
translate zh_cn start_a30c9aa3:

    # y "もちろん、潤も。"
    y "当然，润也是。"

# game/script.rpy:1888
translate zh_cn start_4a0003cb:

    # y "早かったわね……\nはじめてこの家にやってきたのが\n昨日のことのよう。"
    y "一晃这么多年了啊……\n可又觉得，像是昨天才踏进这个家门。"

# game/script.rpy:1890
translate zh_cn start_fc8b38a4:

    # y "……あらためて、潤のこと、\nよろしく頼むわね。"
    y "……再次跟你叨唠一声，\n润就请你多多关照了。"

# game/script.rpy:1892
translate zh_cn start_c54b457f:

    # i "……またすぐ、東京に\n戻ってしまうのに？"
    i "……明明我马上又要回东京了？"

# game/script.rpy:1894
translate zh_cn start_ea004e24:

    # y "ええ。"
    y "嗯。"

# game/script.rpy:1896
translate zh_cn start_9a3e4b58:

    # y "離れていても、家族だもの。"
    y "即使分离各地，我们也依旧是家人。"

# game/script.rpy:1898
translate zh_cn start_0386dc64_7:

    # i "…………"
    i "…………"

# game/script.rpy:1903
translate zh_cn start_6358a514:

    # "とつぜん\n廊下が騒がしくなる。"
    "忽地，走廊那边喧嚷起来。"

# game/script.rpy:1911
translate zh_cn start_fad7ed06:

    # "吹き抜けに、\n風呂あがりの\n潤と樹里の二人があらわれた。"
    "刚出浴的润与树里，\n现身于通风处。"

# game/script.rpy:1913
translate zh_cn start_345a8409:

    # "見ると、潤は顔を真っ赤にして\n咳き込んでいる。"
    "只见润满脸通红，咳个不停。"

# game/script.rpy:1915
translate zh_cn start_4e3269e7:

    # y "どうしたの？"
    y "怎么了？"

# game/script.rpy:1917
translate zh_cn start_5442a187:

    # r "けほっ……もう、殺されるかと\n思ったっての！"
    r "咳……我都以为自己要被杀掉了！"

# game/script.rpy:1919
translate zh_cn start_df64a5f9:

    # j "ごめーん、潤ちゃん。"
    j "抱歉，润酱。"

# game/script.rpy:1921
translate zh_cn start_c500cb9c:

    # i "……何かしたのか？　樹里。"
    i "……你做了什么？　树里。"

# game/script.rpy:1923
translate zh_cn start_fcf595d2:

    # j "潜水ごっこ。"
    j "潜水游戏。"

# game/script.rpy:1925
translate zh_cn start_b7ed73cd:

    # j "の、日本新記録。"
    j "日本新记录。"

# game/script.rpy:1927
translate zh_cn start_720cf675:

    # r "……けほっ……けほっ……"
    r "……咳咳……咳咳……"

# game/script.rpy:1929
translate zh_cn start_5bd1d01d:

    # i "……？"
    i "……？"

# game/script.rpy:1931
translate zh_cn start_017c4def:

    # r "はぁ……はぁ……\n……あっ……せ……"
    r "哈啊……哈啊……要死了……"

# game/script.rpy:1933
translate zh_cn start_9b438364:

    # "僕を見つけた潤は、\nおくればせながら\nパジャマ姿を縮こまらせた。"
    "看到我后，\n意识到只穿着睡衣的润，\n吱溜溜地缩着身子。"

# game/script.rpy:1935
translate zh_cn start_2671ff5e:

    # j "恥ずかしいの？　潤ちゃん。"
    j "你很害羞吗？　润酱。"

# game/script.rpy:1937
translate zh_cn start_44e2051e:

    # "くすくすと樹里が笑う。"
    "树里哧哧地笑了。"

# game/script.rpy:1943
translate zh_cn start_5791f578:

    # "芳野さんがすっと立った。"
    "芳野阿姨立刻站了起来。"

# game/script.rpy:1947
translate zh_cn start_b45719f0:

    # "和やかな空気に似合わぬ\nかたい顔をしている。"
    "她摆出了与和谐空气不相称的僵硬表情。"

# game/script.rpy:1949
translate zh_cn start_31710ab1:

    # y "……潤、\nお風呂場でふざけるのは\nやめなさい。"
    y "……润，不要在浴室嬉闹。"

# game/script.rpy:1951
translate zh_cn start_eab69057:

    # y "思わぬ怪我をするわ。"
    y "会出事的。"

# game/script.rpy:1953
translate zh_cn start_9218be97:

    # r "なに言ってるのママ！\n樹里が、先に……"
    r "妈妈你说什么呢！\n是树里她先……"

# game/script.rpy:1959
translate zh_cn start_523b6002:

    # y "いいわね、潤。"
    y "听话，润。"

# game/script.rpy:1961
translate zh_cn start_efcd74b2:

    # "いきどおる潤をおさえて\n芳野さんがたしなめる"
    "芳野阿姨发出低沉的音调。"

# game/script.rpy:1967
translate zh_cn start_d7192dd7:

    # r "…………は……い……"
    r "…………知道了……"

# game/script.rpy:1969
translate zh_cn start_27ae838c:

    # y "……樹里も。"
    y "……树里也是。"

# game/script.rpy:1971
translate zh_cn start_82a8d6cb:

    # j "はーい。"
    j "知道了。"

# game/script.rpy:1973
translate zh_cn start_6b21f73a:

    # j "芳野ママ。"
    j "芳野妈妈。"

# game/script.rpy:2014
translate zh_cn start_e7c250f0:

    # "年の暮れのせまった駅を\n誰もが足早に行き交う。"
    "车站已经年老色衰，没有谁为之留步。"

# game/script.rpy:2016
translate zh_cn start_bd07ea9b:

    # "濡れ鼠のまま、構内の壁に\nぼうぜんと寄りかかっていた自分に、\n奇異とは異なる眼差しを向ける人がいた。"
    "那时，我浑身湿透，\n像只下水道里的老鼠，正茫然地倚靠在墙边。\n突然，有人向我投来了一种异讶之外的目光——"

# game/script.rpy:2018
translate zh_cn start_d724e28b:

    # g "……伊勢さん？"
    g "……伊势小姐？"

# game/script.rpy:2020
translate zh_cn start_c0456cb3:

    # g "伊勢きりこさん\nでしょう？"
    g "是伊势雾子小姐吧？"

# game/script.rpy:2022
translate zh_cn start_1bd27725:

    # "コート姿の長身の男性が会釈する。"
    "穿着大衣的高挑男性向我点头致意。"

# game/script.rpy:2024
translate zh_cn start_6c483538:

    # g "以前、お会いした山鹿青磁です。"
    g "我是之前跟你见过面的山鹿青磁。"

# game/script.rpy:2026
translate zh_cn start_64b6f0ba:

    # g "どうされたんです。\nそんな……"
    g "你怎么了，这么狼狈……"

# game/script.rpy:2028
translate zh_cn start_84d729c4:

    # "水滴だらけになった眼鏡をはずして\nぼやけた青磁さんの顔を見つめた。"
    "我摘下满是水珠的眼镜，\n看向青磁先生模糊的脸。"

# game/script.rpy:2030
translate zh_cn start_3698c1fa:

    # q "こんばんは。"
    q "晚上好。"

# game/script.rpy:2032
translate zh_cn start_8b8e40b6:

    # q "山鹿さんは、\n帰省されないんですね。"
    q "山鹿先生没有归省啊？"

# game/script.rpy:2034
translate zh_cn start_d0107e7f:

    # g "僕は仕事が……\nいや、そんなことより───"
    g "我是因为工作在身……不，比起这事——"

# game/script.rpy:2036
translate zh_cn start_0c3bb596:

    # "唖然とさせているに\n違いない。"
    "他肯定是被我这样子给惊到了。"

# game/script.rpy:2038
translate zh_cn start_9e319764:

    # q "なんでもないんですよ。"
    q "没什么。"

# game/script.rpy:2040
translate zh_cn start_f6cc1a7f:

    # q "すこし、時間に遅れて\nしまっただけ、で……"
    q "只是稍微迟了一下没赶上班车而已……"

# game/script.rpy:2042
translate zh_cn start_0635f053:

    # "すっかり青ざめた唇で\n笑えたのだろうか。"
    "我那完全变得惨白的嘴唇有好好在笑吗？"

# game/script.rpy:2044
translate zh_cn start_d7cbc303:

    # "……こんな時まで\n取り繕うとしている自分が、\nほんとうに卑しく思えた。"
    "……总觉得，\n这种时候还在掩饰的自己\n很卑微可笑。"

# game/script.rpy:2046
translate zh_cn start_350d7068:

    # "冷えきった胸の奥に、\nいびつに熱が集まる。"
    "冰冷的内心深处，\n聚集着扭曲的热量。"

# game/script.rpy:2048
translate zh_cn start_2c24eabf:

    # "また、\n涙と嗚咽があふれてきた。"
    "眼泪和呜咽，\n再一次，\n溢了出来。"

# game/script.rpy:2053
translate zh_cn start_6f410a81:

    # "青磁さんのマンションで\nシャワーを借り、\n凍てついた体を溶かした。"
    "从青磁先生的公寓那借了浴室，\n冰冷的身体变得暖和起来。"

# game/script.rpy:2055
translate zh_cn start_988a6fdf:

    # "椅子にかけると、\nシンプルなフローリングの部屋からは、\n煙草の匂いがした。"
    "坐在椅子上，\n闻到了房间质朴的木地板中传来的香烟味。"

# game/script.rpy:2059
translate zh_cn start_e259ee91:

    # "それほど\n嫌な匂いではなかった。"
    "并不那么令人讨厌。"

# game/script.rpy:2061
translate zh_cn start_9aeb4fc0:

    # "ひとごこちつくと、\n強いふるえが戻ってくる。"
    "意识恢复了一点后，\n又突然开始激烈颤抖。"

# game/script.rpy:2063
translate zh_cn start_d6fd843f:

    # "風邪をひいたにちがいない。"
    "想必我染了风寒了。"

# game/script.rpy:2065
translate zh_cn start_b1648a8f:

    # g "どうぞ───"
    g "给——"

# game/script.rpy:2067
translate zh_cn start_0ae87dbc:

    # "湯気のたつカップが\nさし出される。"
    "他递给我冒着热气的水杯。"

# game/script.rpy:2069
translate zh_cn start_f82cd4b4:

    # g "少しでも口に入れてください。\nあとで、薬も出します。"
    g "先喝一点吧，过会儿给你药。"

# game/script.rpy:2071
translate zh_cn start_dc211d3a:

    # q "……はい。"
    q "嗯……"

# game/script.rpy:2073
translate zh_cn start_4ac190f3:

    # "私は、カーディガンを寄せて、\nひたすらおとなしく、\n借りてきた猫のようにしている。"
    "我紧抱着开襟羊毛衫，\n像一只老实的猫一样，特别听话。"

# game/script.rpy:2075
translate zh_cn start_0092afa6:

    # "即席のオニオンスープが\n胃にしみこんでいく。"
    "即食的洋葱汤温暖着胃。"

# game/script.rpy:2077
translate zh_cn start_d1134835:

    # "しばらくして、机上のノートパソコンに\n向かっていた青磁さんが振り返った。"
    "过了一会儿，\n青磁先生的目光从桌上的笔记本电脑转向我。"

# game/script.rpy:2079
translate zh_cn start_ac0b3626:

    # g "寒いですか。\n頭痛は？"
    g "冷吗？头疼不疼？"

# game/script.rpy:2081
translate zh_cn start_b7e83ffb:

    # g "……熱が出てくるころでしょう。\n横になって、休んでください。"
    g "……看样子是发烧了，\n躺去床上休息吧。"

# game/script.rpy:2083
translate zh_cn start_dea8fdda:

    # "慣れた手つきで、肘を支えながら、\nパーティションで隔てた\n寝室に案内してくれた。"
    "他熟练地支撑着我的胳膊，\n带我到了隔壁的卧室。"

# game/script.rpy:2085
translate zh_cn start_880bcae2:

    # "足が不自由な相手の\n介護の経験があるのだろう。"
    "是有护理腿部残疾的人的经验吧。"

# game/script.rpy:2087
translate zh_cn start_0c33a6c8:

    # "人心地がついて、にわかに\n恥ずかしさもよみがえってきた。"
    "等我反应过来后，\n又突然感觉很害羞。"

# game/script.rpy:2089
translate zh_cn start_f1163261:

    # g "明日、病院に寄ってから\nご自宅まで送ります。"
    g "明天带你去医院检查后，\n我再把你送到家吧。"

# game/script.rpy:2091
translate zh_cn start_7d1e075d:

    # g "今夜は、\n僕の寝床を使ってください。"
    g "今晚就睡我的床，好好休息吧。"

# game/script.rpy:2093
translate zh_cn start_1d16cc73:

    # q "すみません。"
    q "实在不好意思。"

# game/script.rpy:2095
translate zh_cn start_9116422b:

    # g "男物の寝間着やら、\nがさつな部屋やらで申しわけないが。"
    g "让你穿着男性的睡衣睡在这么乱的房间，\n反而是我该说抱歉呢。"

# game/script.rpy:2097
translate zh_cn start_ca0273b1:

    # q "そんな……\n私の部屋より\n綺麗なくらいです。"
    q "哪里……\n这明明比我的房间还干净呢。"

# game/script.rpy:2099
translate zh_cn start_8aeae40e:

    # "腫れぼったくなった首を、\nこくりと落として\n謝意をあらわした。"
    "我低着昏沉的头，表达感谢。"

# game/script.rpy:2101
translate zh_cn start_c2052aa8:

    # "感謝と、すまない気持ちで\n胸がいっぱいになっていく。"
    "心里盈满了感激之情与歉疚之意。"

# game/script.rpy:2103
translate zh_cn start_106f2910:

    # q "……あの……山鹿さんは？"
    q "那个……山鹿先生今晚要怎么办呢？"

# game/script.rpy:2105
translate zh_cn start_d6e2e224:

    # g "僕は、登山用の寝袋があります。\n部屋も暖かくしておきますから。"
    g "我有登山用的睡袋，\n房间本身就够暖和的。"

# game/script.rpy:2107
translate zh_cn start_7e98853e_1:

    # q "…………"
    q "…………"

# game/script.rpy:2109
translate zh_cn start_9ff651c2:

    # q "ご迷惑をかけますね。"
    q "真是给您添麻烦了啊。"

# game/script.rpy:2111
translate zh_cn start_51663f60:

    # g "いいえ。"
    g "无妨。"

# game/script.rpy:2113
translate zh_cn start_40a3db0f:

    # q "あの……下着とか、コンビニで\n買ってきてくれたんですね。"
    q "那个……\n内衣之类的，\n你居然还为我在便利店买了啊？"

# game/script.rpy:2115
translate zh_cn start_6862d772:

    # g "ははは……少々、緊張しましたが。"
    g "哈哈，虽然有点紧张。"

# game/script.rpy:2117
translate zh_cn start_004f7c1f:

    # "病院の処方薬を分けてもらい、\nパイプベッドに横になった。"
    "拿到医院的处方药后，我躺在床上。"

# game/script.rpy:2119
translate zh_cn start_2966566b:

    # "そういえば、まだ\n化粧水をつけてない……\nそんな悠長な考えが頭をよぎる。"
    "话说，我还没有涂化妆水……\n这种悠然的想法在我脑子里一闪而过。"

# game/script.rpy:2121
translate zh_cn start_82730413:

    # "寝室のあかりが落とされてから\nすっかり弱々しくなった声で\nたずねた。"
    "关灯后，我用万分虚弱的声音问道。"

# game/script.rpy:2123
translate zh_cn start_3c6ef067:

    # q "青磁さん。"
    q "青磁先生。"

# game/script.rpy:2125
translate zh_cn start_f9e5fcca:

    # g "はい。"
    g "怎么了？"

# game/script.rpy:2127
translate zh_cn start_2f94ac19:

    # "シルエットになった\n青磁さんが、私を見つめる。"
    "变成黑影的青磁先生看着我。"

# game/script.rpy:2129
translate zh_cn start_b3d0b8db:

    # "私は、\nそうとう熱があるようだ。"
    "或许，我真是烧得相当厉害吧。"

# game/script.rpy:2131
translate zh_cn start_83e20109:

    # q "簸川五樹さんのこと、\n教えてくれませんか。"
    q "你能告诉我簸川五树的事吗？"

# game/script.rpy:2133
translate zh_cn start_d13c30e1:

    # g "……五樹のことを。"
    g "……告诉你五树的事？"

# game/script.rpy:2135
translate zh_cn start_845490b6:

    # q "なんでもいいんです……\nお願いします。"
    q "什么都好……拜托了。"

# game/script.rpy:2137
translate zh_cn start_878d3618_1:

    # g "…………"
    g "…………"

# game/script.rpy:2139
translate zh_cn start_4ab16dac:

    # g "……ええ、もちろん。\nいいですよ。"
    g "……嗯，当然可以。"

# game/script.rpy:2141
translate zh_cn start_acfdb9cf:

    # g "でも、まずは静養しないと。"
    g "不过，你现在得先静养。"

# game/script.rpy:2143
translate zh_cn start_dc211d3a_1:

    # q "……はい。"
    q "嗯……"

# game/script.rpy:2145
translate zh_cn start_e60fee3c:

    # q "ありがとう。\n青磁さん。"
    q "青磁先生，谢谢你。"

# game/script.rpy:2147
translate zh_cn start_5d1b3092:

    # "隣室から届くタイプ音が、\nとても遠くに聞こえる。"
    "从隔壁传来的打字音变得遥远。"

# game/script.rpy:2149
translate zh_cn start_69cbb5e1:

    # "やがて、またじわりと滲みだした涙を、\nぬぐう気力もないまま、\n私は眠りの中へと沈んでいった。"
    "不久后，\n连擦去再次慢慢溢出的泪水的力气都没有的我，\n沉入了睡眠中。"

# game/script.rpy:2182
translate zh_cn start_f9f1fb11:

    # "今日もまた夏日だった。"
    "今天也充斥着夏。"

# game/script.rpy:2184
translate zh_cn start_02b40912:

    # "薄曇りの空は、その底に、\n澄み切った青空を隠している。"
    "薄薄的云层下，隐藏着澄澈的青空。"

# game/script.rpy:2186
translate zh_cn start_afb05be3:

    # "グリル『ぎとぎと』に顔を出した帰り、\n見覚えのある自転車が、\n坂を駆けおりてきた。"
    "我在餐厅「GITOGITO」露了一下脸后，\n就骑着自行车下坡回去了。"

# game/script.rpy:2190
translate zh_cn start_b0d59c6f:

    # "そのまま、すれちがうかに見えた自転車は、\n短いブレーキ音を鳴らして止まった。"
    "只见一辆擦肩而过的自行车，\n在响着短暂的刹车声后停了下来。"

# game/script.rpy:2192
translate zh_cn start_6b65bac2:

    # i "夏生───"
    i "夏生——"

# game/script.rpy:2197
translate zh_cn start_5b09546b:

    # "振り返れば\n路肩に自転車を寄せながら\nひとつ上の従姉妹が、顔をあげる。"
    "回过头去，\n看到正把自行车靠到路边的堂姐抬起头。"

# game/script.rpy:2199
translate zh_cn start_a9cf34bc:

    # n "おかえり。"
    n "你回来啦。"

# game/script.rpy:2201
translate zh_cn start_effa3a7d:

    # n "あいかわらずみたいね。"
    n "看上去没怎么变呢。"

# game/script.rpy:2203
translate zh_cn start_babc9b77:

    # i "うん。"
    i "嗯。"

# game/script.rpy:2205
translate zh_cn start_af391620:

    # "あまり親密とはいえない距離で\n僕らは向き合った。"
    "我们面对面站着，距离算不上亲密。"

# game/script.rpy:2209
translate zh_cn start_d0e07d89:

    # i "潤を送ってくれて\nありがとう。"
    i "谢谢你把润送回来。"

# game/script.rpy:2213
translate zh_cn start_5e0a2ca4:

    # n "なあに。\nふるさと振興課職員としては\n当然のつとめです。"
    n "没什么啦，\n对负责乡村振兴的公务员来说，\n这是理所应当的职责。"

# game/script.rpy:2215
translate zh_cn start_e01358d7:

    # "いかにも夏生らしい、\n演技がかった身振りで\nほくそ笑む。"
    "看到这非常有夏生感觉的带有演技成分的姿态，\n我暗自嘻笑。"

# game/script.rpy:2217
translate zh_cn start_7fc52462:

    # n "……いい子そうじゃない？"
    n "……看起来是个好孩子呢。"

# game/script.rpy:2222
translate zh_cn start_93df39e0:

    # "僕がうなずくと、\n夏生はサドルに後ろ手をついた。"
    "看到我点头后，夏生靠着车座继续和我聊着。"

# game/script.rpy:2224
translate zh_cn start_94a0e977:

    # n "大事な受験の夏に、こんな僻地に\nドロップアウトだなんて───"
    n "在有着这么重要的考试的夏天，\n来到这么落后的穷乡僻壤——"

# game/script.rpy:2226
translate zh_cn start_1a9a8f0c:

    # n "どんな問題児なんだろうって、\n役場じゃ、みんなヒヤヒヤしてた。"
    n "「那该是多会惹是生非的孩子啊」，\n事务所的大家都挺提心吊胆的。"

# game/script.rpy:2228
translate zh_cn start_41c4b2b5:

    # i "なんだよそれ。"
    i "什么嘛那是。"

# game/script.rpy:2232
translate zh_cn start_85681b49:

    # "顔をほころばせながら\n夏生は僕に一歩近寄った。"
    "夏生边绽开笑容，\n边往我这儿靠近一步。"

# game/script.rpy:2234
translate zh_cn start_cede8bd4:

    # n "だいじょうぶ。"
    n "不要紧哦。"

# game/script.rpy:2236
translate zh_cn start_3fb9cd8e:

    # n "夏生お姉さんは\n気に入ったぞ。"
    n "夏生姐姐很喜欢她哟。"

# game/script.rpy:2238
translate zh_cn start_768a70db:

    # i "……よかった。"
    i "……那真是太好了。"

# game/script.rpy:2240
translate zh_cn start_0cf46721:

    # i "頼むよ。\n大事な後輩なんだ。"
    i "拜托你了，\n这可是我重要的后辈。"

# game/script.rpy:2242
translate zh_cn start_85b341fb:

    # n "───？　後輩って？"
    n "——？　后辈？"

# game/script.rpy:2244
translate zh_cn start_a103b259:

    # "夏生に潤との奇妙な巡り合わせを\n語って聞かせた。"
    "我跟夏生说了自己跟润奇妙的机缘。"

# game/script.rpy:2246
translate zh_cn start_86b5c73f:

    # "夏生は\nそれを感心したそぶりで聞いていた。"
    "夏生吃惊地听着。"

# game/script.rpy:2248
translate zh_cn start_886b76dd:

    # "会話中、つと時計に\n視線を落とす。"
    "说着说着，她突然望向手表。"

# game/script.rpy:2250
translate zh_cn start_e17148c6:

    # n "あっ、やべ。"
    n "呀，不好。"

# game/script.rpy:2254
translate zh_cn start_dfab75a9:

    # i "そろそろ仕事に\n戻ったほうがいいね。"
    i "差不多该上班了吧。"

# game/script.rpy:2256
translate zh_cn start_77d2bf14:

    # n "そうみたいね。"
    n "的确如此。"

# game/script.rpy:2258
translate zh_cn start_359e3c8e:

    # n "それじゃ、五樹。"
    n "那就这样吧，五树。"

# game/script.rpy:2260
translate zh_cn start_a914c903:

    # i "うん。\nあんまりスピード\n出し過ぎないように。"
    i "嗯，别骑得太快。"

# game/script.rpy:2262
translate zh_cn start_09cd6463:

    # n "へーい。"
    n "好啦好啦。"

# game/script.rpy:2266
translate zh_cn start_9edd257b:

    # "歩きかけたところで\n呼び止められた。"
    "在快走的时候，\n她又叫住了我。"

# game/script.rpy:2270
translate zh_cn start_ff9e3564:

    # n "い……五樹……"
    n "五……五树……"

# game/script.rpy:2272
translate zh_cn start_911bda45:

    # "うわずった声でささやく。"
    "她的声音支支吾吾的。"

# game/script.rpy:2274
translate zh_cn start_a05cbebb:

    # n "…………"
    n "…………"

# game/script.rpy:2276
translate zh_cn start_421e6941:

    # i "うん？"
    i "嗯？"

# game/script.rpy:2280
translate zh_cn start_db9fcb42:

    # n "……い、いつまでいるの？\nこっちには。"
    n "……你能在这儿、在这儿呆到什么时候？"

# game/script.rpy:2282
translate zh_cn start_fca30516:

    # i "明日には発つよ。"
    i "明天走。"

# game/script.rpy:2284
translate zh_cn start_b2501108:

    # n "えっ……明日……？"
    n "诶……明天……？"

# game/script.rpy:2286
translate zh_cn start_0126a64c:

    # n "ずいぶん早いんだ。"
    n "走这么早啊。"

# game/script.rpy:2288
translate zh_cn start_4da9009d:

    # i "うん。\nごめん。"
    i "嗯，抱歉。"

# game/script.rpy:2290
translate zh_cn start_903f5a3c:

    # n "い、いいって。\nそっか……"
    n "没、没事啦。这样啊……"

# game/script.rpy:2292
translate zh_cn start_a547967f:

    # n "わ、わたしさ……"
    n "我、我啊……"

# game/script.rpy:2294
translate zh_cn start_a05cbebb_1:

    # n "…………"
    n "…………"

# game/script.rpy:2296
translate zh_cn start_94e180a1:

    # "夏生は、苦しそうに\n言葉につまっていた。"
    "夏生像是很痛苦地一时语塞。"

# game/script.rpy:2300
translate zh_cn start_d068696b:

    # n "み、見送り行こっか？"
    n "要、要我去给你送行吗？"

# game/script.rpy:2302
translate zh_cn start_f9585471:

    # i "……見送り？"
    i "……送行？"

# game/script.rpy:2304
translate zh_cn start_549bacef:

    # i "そんなの、一度だって\n来たことないだろ。\nいいよ、別に。"
    i "这种事你不是一次都没做过嘛，\n不用来啦。"

# game/script.rpy:2306
translate zh_cn start_5e3d3df3:

    # n "そ、そうだね、はは。"
    n "也、也是啊，哈哈。"

# game/script.rpy:2308
translate zh_cn start_24d62b73:

    # i "大丈夫だよ。\nこれでも普通に大学生してるから。"
    i "不用担心啦。\n我好歹也是个大学生啦。"

# game/script.rpy:2310
translate zh_cn start_dee33301:

    # i "きょう、会えてよかった。"
    i "今天能见到你真是太好了。"

# game/script.rpy:2314
translate zh_cn start_680ace99:

    # n "うん……"
    n "嗯……"

# game/script.rpy:2316
translate zh_cn start_f81c427e:

    # n "……大丈夫だよね。　　　　　　　　　\n五樹だものね。"
    n "一定没问题的吧。　　　　　　　　　\n毕竟是五树呢。"

# game/script.rpy:2347
translate zh_cn start_2a588548:

    # j "中に入ってみないの？"
    j "不进去看看吗？"

# game/script.rpy:2349
translate zh_cn start_95d2b62b:

    # r "……いい。"
    r "去啊……"

# game/script.rpy:2351
translate zh_cn start_822da3bc:

    # r "外から閉じこめたり\nする気だろ。"
    r "你是想从外面把我困住吧？"

# game/script.rpy:2353
translate zh_cn start_10a6f88b:

    # j "しないよ。\nそんな子供みたいなこと。"
    j "才不会做那种幼稚的事呢。"

# game/script.rpy:2355
translate zh_cn start_880bb671:

    # r "…………うー……"
    r "…………呜……"

# game/script.rpy:2359
translate zh_cn start_51c6f9b1:

    # j "うたぐりぶかいなあ、潤ちゃん。"
    j "润酱可真是多疑呢。"

# game/script.rpy:2363
translate zh_cn start_6366fa88:

    # r "……あのなー。"
    r "我说啊，"

# game/script.rpy:2367
translate zh_cn start_c0a17555:

    # r "いきなり抱きつかれて、\n湯船に潜ったりされたら、\nトラウマにもなるっての。"
    r "突然被抱住潜进浴池里什么的，\n不管是谁都会产生心理阴影的吧。"

# game/script.rpy:2369
translate zh_cn start_a00ddac0:

    # "渋い顔の潤をよそに、\n樹里は屈託なく笑った。"
    "面对着一脸苦涩的润，树里开心地笑了。"

# game/script.rpy:2373
translate zh_cn start_a7d568e3:

    # j "ごめんねー。\nでも、うちのお風呂広いでしょ？"
    j "抱歉啊，我们家泳池不是很大。"

# game/script.rpy:2378
translate zh_cn start_668019f3:

    # r "ンあ？　ああ───"
    r "嗯……　啊？——"

# game/script.rpy:2380
translate zh_cn start_fd61a285:

    # "どこからつながった話だよ、\nとぼやきながら、潤は相づちをうつ。"
    "「这又是哪儿跟哪儿啊……」，\n润边这样发着牢骚边应和着。"

# game/script.rpy:2382
translate zh_cn start_ed74742c:

    # j "母さんはあの場所で\n死んだの。"
    j "妈妈就是在那里去世的。"

# game/script.rpy:2384
translate zh_cn start_a700cc97:

    # r "……え……っ……"
    r "……诶？…………"

# game/script.rpy:2389
translate zh_cn start_c1790a87:

    # "面くらう潤を置いて\n樹里はすっと前へ出て、\n暗闇にとけ込んでいく。"
    "把不知所措的润放在一边，\n树里轻快地走向前去，\n和黑暗融为一体。"

# game/script.rpy:2406
translate zh_cn start_28277e64_7:

    # r "…………"
    r "…………"

# game/script.rpy:2408
translate zh_cn start_561a2fd9:

    # "あとから、おそるおそる\n潤は足を踏み入れた。"
    "润在后面战战兢兢地踏了进去。"

# game/script.rpy:2410
translate zh_cn start_734e5ec2:

    # "鉄錆と、土の匂い。\n年月を経た物たちの匂い。"
    "铁锈和泥土的味道杂糅在空气中，\n一切物品都散发着岁月的气息。"

# game/script.rpy:2412
translate zh_cn start_7a079cca:

    # "静寂が、鼓膜を押しつける"
    "耳膜的平静反映了周围的寂静。"

# game/script.rpy:2414
translate zh_cn start_75236913:

    # r "ここ……まだ\n使ってるの？"
    r "这里……还在用吗？"

# game/script.rpy:2417
translate zh_cn start_825161b6:

    # "樹里は無言のまま、\nしばらくその場に立っていた。"
    "树里什么也没说，只是站在那里。"

# game/script.rpy:2420
translate zh_cn start_27196d16:

    # j "……そうね、一応。\nめったに開けないけど。"
    j "……姑且是呢，但很少打开。"

# game/script.rpy:2422
translate zh_cn start_1d345efa:

    # j "本当は、毎日手入れしないと\n蔵も傷んでしまうんだって。"
    j "其实不经常保养的话，\n仓库里的东西也会受损。"

# game/script.rpy:2424
translate zh_cn start_7be62851:

    # r "へえ。"
    r "是嘛。"

# game/script.rpy:2426
translate zh_cn start_8253ccc0:

    # r "やっぱり\n骨董品とかあるのかな。"
    r "是因为有古董之类的吗？"

# game/script.rpy:2428
translate zh_cn start_d959e041:

    # j "あるんじゃないかな。\nピストルとか。"
    j "有的吧，像手枪什么的。"

# game/script.rpy:2430
translate zh_cn start_b97fb638:

    # r "ピストルっ？"
    r "手枪？"

# game/script.rpy:2432
translate zh_cn start_1031541b:

    # j "どうせ、もう錆びついて使えないよ。"
    j "反正已经生锈得不能使用了。"

# game/script.rpy:2434
translate zh_cn start_67eeec35:

    # r "……そろそろ行こう。"
    r "……差不多该走了吧。"

# game/script.rpy:2438
translate zh_cn start_b2038b14:

    # j "…………"
    j "…………"

# game/script.rpy:2440
translate zh_cn start_0ca30876:

    # r "……樹里？\n閉めよう。"
    r "树里？关上吧。"

# game/script.rpy:2442
translate zh_cn start_3802df10:

    # j "うん……"
    j "嗯……"

# game/script.rpy:2444
translate zh_cn start_00ad1847:

    # j "もうすこし、いるわ。\n潤ちゃん先に行ってて。"
    j "让我自己在这儿待会儿，\n润酱你先走吧。"

# game/script.rpy:2448
translate zh_cn start_2d76117d:

    # r "……いいけど。"
    r "也行……"

# game/script.rpy:2453
translate zh_cn start_b2038b14_1:

    # j "…………"
    j "…………"

# game/script.rpy:2463
translate zh_cn start_0bb337f1:

    # j "………………"
    j "………………"

# game/script.rpy:2465
translate zh_cn start_0ae9b9f9:

    # j "泣いては、だめ。"
    j "不能哭。"

# game/script.rpy:2469
translate zh_cn start_1a625b9b:

    # j "─────母さん。"
    j "——————母亲。"

# game/script.rpy:2473
translate zh_cn start_e458d7d2:

    # j "母さんはもう\nここには、いないの。"
    j "母亲已经，\n不在这儿了。"

# game/script.rpy:2475
translate zh_cn start_53ce3bd7:

    # j "だから、泣いてはだめ。"
    j "所以，不能哭。"

# game/script.rpy:2477
translate zh_cn start_ab9f6a28:

    # j "あたしを　　　　　　　　　　　　　\nいらつかせないで。"
    j "别过来　　　　　　　　　　　　　\n不要让我发火。"

# game/script.rpy:2481
translate zh_cn start_37b147f2:

    # j "……消えて……"
    j "……消失吧……"

# game/script.rpy:2485
translate zh_cn start_409f2af6:

    # j "…………消えて。"
    j "…………快点消失吧。"

# game/script.rpy:2512
translate zh_cn start_121d6220:

    # "ふと目覚める。\n薄明までは、まだ遠い。"
    "突然间张目醒来，黎明尚远。"

# game/script.rpy:2519
translate zh_cn start_d88e32f7:

    # "暗がりに、ぼんやりと\n白く細い背中が浮かびあがる。"
    "昏朦之中，\n一截白皙纤弱的背脊幽幽浮现。"

# game/script.rpy:2521
translate zh_cn start_53560d4b:

    # "間近に腰かけた樹里の瞳が、\n僕をじっと見つめていた。"
    "近旁屈身坐着的树里，\n双眸正静静凝望着我。"

# game/script.rpy:2523
translate zh_cn start_c6d2eef9:

    # "下着ひとつ、身につけていない。"
    "她身上未着一缕。"

# game/script.rpy:2525
translate zh_cn start_b82350ca:

    # "夜の、ひんやりとした空気のなかで\n裸身は濃密な汗の匂いを\nふりまいていた。"
    "夜的沁凉空气里，\n那赤裸散斥着她浓密的汗息。"

# game/script.rpy:2527
translate zh_cn start_8d8c0460:

    # "おぼろげな眠りの淵に浸かったまま、\n僕は、少女と視線を絡めあわせる。"
    "我沉在朦胧睡意的边缘，\n与少女的视线悄然交缠。"

# game/script.rpy:2529
translate zh_cn start_f2e01f73:

    # "少女は吸い込まれるように、\nしのびやかに薄掛けにもぐり\n身体をあずけてきた。"
    "少女的身体悄悄地流入薄薄的被子，\n将身子倚靠过来。"

# game/script.rpy:2536
translate zh_cn start_2702ce39:

    # "猫のように丸まって\nしっとりと濡れた背を押しつける。"
    "像猫儿般蜷着，\n将湿润的后背压在我的身上。"

# game/script.rpy:2538
translate zh_cn start_94e71bd4:

    # "甘くなまなましい残り香は、いまだ\n彼女が、肉欲の行為の余韻にあることを\n教えていた。"
    "那甜腻到腐烂的芳香，\n告知我鱼水交合的韵调。"

# game/script.rpy:2540
translate zh_cn start_48770438:

    # "濡れた髪をわけながら、\n伸ばした指先を、\nそっと少女のこめかみへ重ねる。"
    "撩开她湿漉漉的头发，\n我轻轻将指尖叠在她的太阳穴上。"

# game/script.rpy:2542
translate zh_cn start_fbcab327:

    # "いつも、病床の樹里に\nそうしていたように。"
    "一如往常，\n一如在病床畔对待树里那般。"

# game/script.rpy:2544
translate zh_cn start_aca90ea0:

    # "樹里は、熱もつ頬を僕の指先に添えて応え、\nひっそりと愛おしむ。"
    "滚烫的脸颊回应了我的指尖，\n默默地疼爱着我。"

# game/script.rpy:2546
translate zh_cn start_99632a27:

    # "それが僕らの会話だった。"
    "这就是我们的交流方式。"

# game/script.rpy:2548
translate zh_cn start_723876dd:

    # "ぬくもりと、懐かしき想いに\n胸が……つかえる。"
    "暖意与眷念堵在胸口……\n几乎哽咽。"

# game/script.rpy:2550
translate zh_cn start_44935166:

    # "やっと、帰るべき場所に\n帰ってきたのだ。"
    "我终于，\n回到了理应归去的地方。"

# game/script.rpy:2552
translate zh_cn start_80d2321a:

    # "僕の、たったひとつの\n居場所へ。"
    "回到了，\n我唯一的归属。"

# game/script.rpy:2556
translate zh_cn start_ce6c6bba:

    # j "………おかえり……兄さん…………"
    j "……你醒了……哥哥…………"

# game/script.rpy:2560
translate zh_cn start_49801789:

    # "ふるえるつぶやきに\n長い苦悶を経た色が\nありありと浮かぶ。"
    "颤抖的低语中，\n浮起历尽漫长苦闷的鲜烈颜色。"

# game/script.rpy:2562
translate zh_cn start_bc4e99f5:

    # "少女のなかに、いまだ消えず\n心を舐め焦がす、昏い炎───"
    "少女魂中仍未熄灭的幽焰，\n舔舐并燃烧着少女的心。"

# game/script.rpy:2564
translate zh_cn start_62e3a7c7:

    # "あたかも調律を欠いた楽器が、\nそれでも悲鳴を奏でることを\nやめないでいるような───"
    "犹如失调的乐器被强行演奏，\n不肯停止嘶吼——"

# game/script.rpy:2566
translate zh_cn start_335b512c:

    # "そんな哀しい音色で、\nこの瞬間も叫び続けている。"
    "那失重的悲鸣，\n此时此刻仍持续在呐喊——"

# game/script.rpy:2570
translate zh_cn start_31c81cb9:

    # j "……知ってる…………兄さん……？"
    j "……你知道吗…………哥哥……？"

# game/script.rpy:2572
translate zh_cn start_f1d6628b:

    # j "母さんと父さん……ふたり……\n兄妹だったのですって……"
    j "妈妈和爸爸……他们俩……\n听说原本是兄妹……"

# game/script.rpy:2574
translate zh_cn start_3f68e37f:

    # i "…………ああ……"
    i "…………嗯……"

# game/script.rpy:2576
translate zh_cn start_0e673d00:

    # "知っていた。"
    "我知道的。"

# game/script.rpy:2578
translate zh_cn start_3ded6473:

    # "僕らの両親が、簸川家に拾われた\nみなし子だったことは\n早くに知っていた。"
    "我很早就已经知道，\n我们的双亲是被簸川家捡回来的孤儿。"

# game/script.rpy:2580
translate zh_cn start_5bfa9071:

    # "けっして広くはないこの町で、\n隠し通していけることは少ない。"
    "在这座不算辽阔的小镇里，\n很少有什么事是能隐藏到底的。"

# game/script.rpy:2582
translate zh_cn start_520e75c4:

    # "ふたりを出奔させた罪悪感からか、\n今では、むしろ丁寧に\n迎えられるようになった。"
    "许是出于使两人出走的愧疚，\n大家后来对他们的态度变得友善。"

# game/script.rpy:2586
translate zh_cn start_9dc1d7a0:

    # "ふたり……\n兄妹だったのかもしれない。\nもう誰にもわからないことだ。"
    "他们两人说不定是兄妹……\n不过也没人知道真相。"

# game/script.rpy:2588
translate zh_cn start_c4947217:

    # j "だったら……"
    j "那样的话……"

# game/script.rpy:2590
translate zh_cn start_899fd51e:

    # j "……だとしたら、あたしたち、\n普通とはちがうわ。"
    j "……若是那样，我们，\n就与常人不同了。"

# game/script.rpy:2592
translate zh_cn start_c38e982f:

    # j "兄妹より近くて\n双子よりは遠い……\nなにかね。"
    j "比兄妹更亲近，\n却比双子遥远些的……\n某种存在呢。"

# game/script.rpy:2596
translate zh_cn start_7d09c0b4:

    # "そのくちぶりには\nおのれを貶めつつも\n押し隠した喜びがあった。"
    "她用她的唇，\n通过轻蔑的话语压抑自己，\n但语气中流出了心里暗藏的喜悦。"

# game/script.rpy:2598
translate zh_cn start_3b23a4a4:

    # "むなしく僕は言葉をくくる。"
    "我道出她的徒劳："

# game/script.rpy:2600
translate zh_cn start_8299ab71:

    # i "……他人だよ。誰だって。"
    i "……都是外人啊，任谁都是。"

# game/script.rpy:2602
translate zh_cn start_9f59d502:

    # i "どんなにしても\nひとつにはなれない。"
    i "无论如何，\n都无法真正合而为一。"

# game/script.rpy:2604
translate zh_cn start_3073d151:

    # j "兄さんに\nこうして抱かれていても……？"
    j "就算像这样被哥哥抱着……？"

# game/script.rpy:2606
translate zh_cn start_d3d35b52:

    # i "……うん……"
    i "……对……"

# game/script.rpy:2608
translate zh_cn start_4cb7d254:

    # j "一日じゅう\nずっと、ずっと、死ぬまで\nセックスしていても……？"
    j "就算是一整天都在和哥哥做爱，\n一辈子都和哥哥做爱，\n到死为止都交融在一起？"

# game/script.rpy:2610
translate zh_cn start_96a3feef:

    # i "……ああ……"
    i "……是……"

# game/script.rpy:2612
translate zh_cn start_6901bd2b:

    # i "……飽きるまで体をこすりあわせても、\nいくら強く、互いを想っても、\n本当に一緒になんかなれないよ。"
    i "就算交欢到厌烦，\n无论多么强烈地思念彼此，\n我们都不可能真正地成为一体。"

# game/script.rpy:2614
translate zh_cn start_1614fe4d:

    # i "父さんは……それで疲れきったんだ。"
    i "爸爸……他也因为这点而疲惫不堪。"

# game/script.rpy:2616
translate zh_cn start_bd9f6724:

    # j "……兄さんはちがうわ。"
    j "……哥哥你是不一样的。"

# game/script.rpy:2618
translate zh_cn start_fe37cd8b:

    # i "同じなんだ。\n変わらない心も、死なない心も、\nそんなもの、どこにも無い。"
    i "一样的啊，\n不变的心，亦或是不死的心，\n那东西哪里都不会存在啊。"

# game/script.rpy:2620
translate zh_cn start_6a1c646b:

    # i "もろい心が、あるだけだよ。"
    i "我有的，只是一颗脆弱的心。"

# game/script.rpy:2622
translate zh_cn start_21337419:

    # "そんな戯れ言に抗うように\n樹里は、ますます身体を\nすりよせてきた。"
    "树里像是要反抗我的胡话一样，\n将身体与我紧紧交缠。"

# game/script.rpy:2624
translate zh_cn start_e321eb92:

    # j "いえ、\n兄さんはちがう。"
    j "不，\n哥哥不一样。"

# game/script.rpy:2626
translate zh_cn start_7a50d0ae:

    # j "兄さんは、ちがう。"
    j "哥哥，就是不一样。"

# game/script.rpy:2630
translate zh_cn start_1e9a6935:

    # j "……どうしたらいいの。"
    j "……我该怎么办才好。"

# game/script.rpy:2632
translate zh_cn start_b837c3a8:

    # j "誰もが、\n嘘とか、まぼろしを見て\nただ死んでいくなんて。"
    j "大家相信着生的谎言，\n把手伸向幸福的幻影，\n最后又愚蠢的死去。"

# game/script.rpy:2634
translate zh_cn start_0484b738:

    # j "だったらこんな、きょうやあしたに、\nどんな意味があるの。"
    j "那这样的今天与明天，\n还有什么意义？"

# game/script.rpy:2636
translate zh_cn start_734668ec:

    # j "……わからないよ…………"
    j "……我不明白啊…………"

# game/script.rpy:2638
translate zh_cn start_0386dc64_8:

    # i "…………"
    i "…………"

# game/script.rpy:2640
translate zh_cn start_5ed28013:

    # "いっそこの世界に\nふたりきりなら……"
    "倘若这世上\n只剩我们二人……"

# game/script.rpy:2642
translate zh_cn start_2b831a3b:

    # "樹里と、この僕だけが\n世界のすべてだったのなら、\n赦されたのだろうか。"
    "若树里与我这副身躯\n便是世界的全部，\n是否就能得到宽恕呢？"

# game/script.rpy:2644
translate zh_cn start_ccffb9f9:

    # "僕の胸中を読みとったように\n樹里が続ける。"
    "仿佛读懂了我心中所思，\n树里继续说着："

# game/script.rpy:2646
translate zh_cn start_425b1735:

    # j "……そう…………"
    j "……是啊…………"

# game/script.rpy:2648
translate zh_cn start_d362cbec:

    # j "……小さいころは、\nあたしと兄さん、\n確かにふたりきりだったのに……"
    j "……小时候，\n我和哥哥，\n明明确实只有彼此的……"

# game/script.rpy:2650
translate zh_cn start_0586afae:

    # j "いつからなんだろ……"
    j "然而，从什么时候起……"

# game/script.rpy:2652
translate zh_cn start_a9fb9d32:

    # j "あたしの初潮の日から……なのかな……\n……そんなこと……？"
    j "是我初潮那天后吗……\n……是那样吗……？"

# game/script.rpy:2654
translate zh_cn start_2a6a5eb1:

    # i "あきらめるんだ。"
    i "放弃吧。"

# game/script.rpy:2656
translate zh_cn start_4bb03647:

    # j "あきらめないわ。"
    j "我不会放弃的。"

# game/script.rpy:2658
translate zh_cn start_f71a3729:

    # "ふたりとも口を閉ざしたまま、\n時間が流れていく。"
    "我们两人都沉默了。\n沉默中，只剩时间在慢慢流逝。"

# game/script.rpy:2660
translate zh_cn start_c1253a39:

    # "恐怖とともに、また朝が近づいてくる。"
    "伴随着恐惧，清晨再度逼近。"

# game/script.rpy:2662
translate zh_cn start_566b646d:

    # "眠ってしまったかに見えた樹里が\nまたふと口をひらいた。"
    "似乎睡着了的树里突然又张开了嘴。"

# game/script.rpy:2664
translate zh_cn start_1e46425f:

    # j "……明日には、\n行ってしまうんでしょう。"
    j "……明天，\n你就要离开了吧。"

# game/script.rpy:2666
translate zh_cn start_ef92a71f:

    # j "でも……また、\n戻ってきてくれる。"
    j "但是……哥哥还是会，\n再回到我身边的。"

# game/script.rpy:2668
translate zh_cn start_61c3403c:

    # i "……戻らない。　　　　　　　　　　\n今度は。"
    i "……不会回来了。　　　　　　　　　　\n就这次。"

# game/script.rpy:2670
translate zh_cn start_1aa39398:

    # j "嘘。"
    j "骗子。"

# game/script.rpy:2672
translate zh_cn start_0386dc64_9:

    # i "…………"
    i "…………"

# game/script.rpy:2674
translate zh_cn start_27eeb52e:

    # j "潤ちゃんを\n置いてけぼりにしても……いいの？"
    j "把润酱就这样丢下不管……\n……也可以吗？"

# game/script.rpy:2676
translate zh_cn start_20e56a41:

    # i "……潤にさわるな。"
    i "……不要打润的主意。"

# game/script.rpy:2678
translate zh_cn start_cb97c696:

    # i "無視するんだ。"
    i "无视她吧。"

# game/script.rpy:2680
translate zh_cn start_b2038b14_2:

    # j "…………"
    j "…………"

# game/script.rpy:2682
translate zh_cn start_8b9e5366:

    # i "…………樹里。"
    i "树里…………"

# game/script.rpy:2684
translate zh_cn start_a808e380:

    # "責めるように呼んでも\n樹里は、僕の胸もとに\n頭をすりつけるだけだ。"
    "即便我用责备的语气唤她，\n树里也只是将头\n埋在我胸前磨蹭。"

# game/script.rpy:2686
translate zh_cn start_03f2a7ab:

    # "イタズラっぽくつぶやく。"
    "她故作淘气地嘟着。"

# game/script.rpy:2688
translate zh_cn start_31e6a491:

    # j "……かわいそうね。\n潤ちゃん。"
    j "润酱真可怜啊……"

# game/script.rpy:2690
translate zh_cn start_0e142906:

    # j "愛してもいないのにね……\nむしろ鬱陶しくすら\n思っているのに。"
    j "明明不被你爱着……\n甚至可能觉得她碍事呢。"

# game/script.rpy:2692
translate zh_cn start_71ba45cf:

    # j "ただいつまでも\n優しいままだなんて……"
    j "却要被永远地\n温柔相待什么的……"

# game/script.rpy:2694
translate zh_cn start_c44994a8:

    # j "残酷なのは\n父さんと同じね。"
    j "这份残酷，\n哥哥倒是和爸爸一样呢。"

# game/script.rpy:2696
translate zh_cn start_0386dc64_10:

    # i "…………"
    i "…………"

# game/script.rpy:2721
translate zh_cn start_7ea8118e:

    # "なかば肺炎になりかけていた伊勢きりこは、\nそのまま丸一日寝込んだ。"
    "险些得肺炎的伊势雾子就那样睡了一整天。"

# game/script.rpy:2723
translate zh_cn start_cd51feea:

    # "翌々日、かなり無理をしながらも\n山鹿青磁のもとから帰宅する。"
    "次日，即使相当虚弱，\n她还是倔强地离开了青磁家。"

# game/script.rpy:2725
translate zh_cn start_4b60f9fc:

    # "送ろうとした青磁を断りながらも、\n伊勢きりこは、青磁との約束の念を押した。"
    "虽说拒绝了青磁送她回家的提议，\n但伊势雾子还是遵从青磁的医嘱。"

# game/script.rpy:2731
translate zh_cn start_56b075ee:

    # "数日後、帰宅した青磁の耳に\nしばらく鳴り続けていたふうな\n呼び出し音が届いた。"
    "几天后，青磁刚回到家，\n耳边就传入了阵阵「嗡嗡」声，\n似乎响了很久。"

# game/script.rpy:2733
translate zh_cn start_742eed66:

    # "もう夜遅く、\n日が変わろうとする時刻だった。"
    "夜已深，日期将变。"

# game/script.rpy:2735
translate zh_cn start_e97e5e62:

    # "ディスプレイには\n見慣れない番号が\n表示されていた。"
    "出现在屏幕上的是一串陌生的号码。"

# game/script.rpy:2737
translate zh_cn start_7e69f522:

    # "少しためらいながらも、\n受話器をとる。"
    "犹豫了一会儿，他拿起了电话。"

# game/script.rpy:2739
translate zh_cn start_30b1bb66:

    # g "はい、山鹿です。"
    g  "您好，我是山鹿。"

# game/script.rpy:2741
translate zh_cn start_65728828:

    # "「…………」"
    "「…………」"

# game/script.rpy:2743
translate zh_cn start_53048a7b:

    # g "もしもし……？"
    g "您好……？"

# game/script.rpy:2745
translate zh_cn start_1d1cd9f9:

    # "沈黙したままの受話器を下ろしかけた時、かすれた、小さな声が聞こえた。"
    "正欲放下那持续沉默的听筒时，\n他听见一道沙哑的、细微的声音。"

# game/script.rpy:2747
translate zh_cn start_7b65a52f:

    # "「セイ……」"
    "「青……」"

# game/script.rpy:2751
translate zh_cn start_7d9b9298:

    # g "…………五樹か？"
    g "……是五树吗……？"

# game/script.rpy:2753
translate zh_cn start_d9644f99:

    # "青磁の表情がこわばった。"
    "青磁的表情僵住了。"

# game/script.rpy:2755
translate zh_cn start_6bb324f9:

    # "「……セイ」"
    "「……青。」"

# game/script.rpy:2757
translate zh_cn start_e85d0448:

    # g "どうしたんだ。"
    g "怎么了？"

# game/script.rpy:2759
translate zh_cn start_3176c283:

    # "平静を装いながら、尋ねる。"
    "故作镇静地问着。"

# game/script.rpy:2761
translate zh_cn start_c873b941:

    # "「……声が聴きたかっただけだよ」"
    "「……只是想听听你的声音而已。」"

# game/script.rpy:2763
translate zh_cn start_878d3618_2:

    # g "…………"
    g "…………"

# game/script.rpy:2765
translate zh_cn start_ed34c69a:

    # g "……話してみろよ。"
    g "……和我说吧。"

# game/script.rpy:2767
translate zh_cn start_10c1b547:

    # g "言いたいことがあるんだろ。"
    g "你是有话想说吧。"

# game/script.rpy:2769
translate zh_cn start_4f8f5fee:

    # "「………………」"
    "「………………」"

# game/script.rpy:2771
translate zh_cn start_3129d899:

    # "「…………きっと……」"
    "「…………一定是……」"

# game/script.rpy:2773
translate zh_cn start_ab14b661:

    # "「……きっともう、時間は、\n　とっくに過ぎてたんだ」"
    "「过去的日子啊，\n　早一定是烟消云散了……」"

# game/script.rpy:2775
translate zh_cn start_f29982c9:

    # "「ただ、僕が、ためらい続けていた\n　だけで……」"
    "「只有我还在……\n　原地徘徊……」"

# game/script.rpy:2777
translate zh_cn start_878d3618_3:

    # g "…………"
    g "…………"

# game/script.rpy:2779
translate zh_cn start_8325463f:

    # "「樹里を……\n　楽にしてやりたい……」"
    "「我想让树里……\n　解放……」"

# game/script.rpy:2781
translate zh_cn start_593132fa:

    # "「これ以上、\n　苦しませたくないんだ……」"
    "「不想让她……\n　再这样痛苦下去了……」"

# game/script.rpy:2783
translate zh_cn start_6ed2ae83:

    # g "………………"
    g "………………"

# game/script.rpy:2785
translate zh_cn start_cdfd18ab:

    # "「……セイ…………」"
    "「……青…………」"

# game/script.rpy:2787
translate zh_cn start_2b456847:

    # "「セイの父さんを、\n　助けてあげられたのは\n　セイだろ？」"
    "「那时坚持让青的父亲，\n　继续接受治疗的，只有青，\n　对吧？」"

# game/script.rpy:2789
translate zh_cn start_d77631c9:

    # g "…………ああ。"
    g "…………嗯。"

# game/script.rpy:2791
translate zh_cn start_07efb9dc:

    # "「医者は……いつも役立たずだった……\n　もう自分の身体なんかじゃ、\n　なくなっていた……」"
    "「医生已经救不了树里了……\n　树里的身体……\n　已经开始与她的灵魂分离了…………」"

# game/script.rpy:2793
translate zh_cn start_a3e0f5a1:

    # "「毎晩、動物みたいにうなり声をあげて、\n　あんなにまでして生きなきゃ\n　いけないなんて」"
    "「每晚像野兽一样渴求呻吟，\n　为了活下去，\n　居然必须忍受这样的不堪……」"

# game/script.rpy:2795
translate zh_cn start_a1889238:

    # "「僕の母さんだって───」"
    "「就和我的母亲朱音一样───」"

# game/script.rpy:2797
translate zh_cn start_ac02d0ff:

    # g "───やめろ、五樹！"
    g "——打住吧，五树！"

# game/script.rpy:2799
translate zh_cn start_a9472d1f:

    # "「……」"
    "「……」"

# game/script.rpy:2801
translate zh_cn start_3b213063:

    # g "伊勢さんに会った。\nお前のことを聞かせた。"
    g "我与伊势见了面，\n打听了你的一些近况。"

# game/script.rpy:2803
translate zh_cn start_65728828_1:

    # "「…………」"
    "「…………」"

# game/script.rpy:2805
translate zh_cn start_204bfc78:

    # g "伊勢さんは、お前を───"
    g "伊势，她对你——"

# game/script.rpy:2807
translate zh_cn start_736aa088:

    # "「いい人だろ……伊勢さん」"
    "「伊势……她……是个好人。」"

# game/script.rpy:2809
translate zh_cn start_f6dab8e8:

    # g "……ああ。"
    g "是啊……"

# game/script.rpy:2811
translate zh_cn start_2cf4ce50:

    # g "彼女ならお前を、\n支えてくれる、きっと……"
    g "我相信，她能成为你的支柱。"

# game/script.rpy:2813
translate zh_cn start_aa0bc2bd:

    # g "でなけりゃ……\n……俺を……頼れよ……っ……"
    g "不行的话……\n就来……\n依靠我啊……"

# game/script.rpy:2815
translate zh_cn start_1be0935b:

    # g "…………ひとりで……なんでも……\n……背負い込むなよ……"
    g "……不要什么事都独自一人……\n不要一个人背负一切啊……"

# game/script.rpy:2817
translate zh_cn start_bafb473a:

    # g "……………………"
    g "……………………"

# game/script.rpy:2819
translate zh_cn start_b5b3974e:

    # "「……もうじゅうぶん、\n　いろんなものを貰ったよ」"
    "「……我在你那里依靠的，\n　已经够多了。」"

# game/script.rpy:2821
translate zh_cn start_878d3618_4:

    # g "…………"
    g "…………"

# game/script.rpy:2823
translate zh_cn start_1ecc7264:

    # "「ハ……ハハッ……」"
    "「哈……哈哈……」"

# game/script.rpy:2825
translate zh_cn start_80148604:

    # "「ちょっと心配をかけたくなったんだ」"
    "「我只是想让你担心我一下。」"

# game/script.rpy:2827
translate zh_cn start_22039afa:

    # "「大丈夫。\n　元気になったよ……」"
    "「没事，\n　我已经精神了……」"

# game/script.rpy:2829
translate zh_cn start_58f171ca:

    # "「ごめん……悪かったね……」"
    "「抱歉……打扰你了啊……」"

# game/script.rpy:2831
translate zh_cn start_49c8f879:

    # g "……………"
    g "……………"

# game/script.rpy:2847
translate zh_cn start_3c76e4cf:

    # r "樹里も誘ったんだけど……\n眠い、とか言って、\nちっとも起きなくって。"
    r "虽然我也喊了树里……\n但她说着好困之类的话，继续睡去了。"

# game/script.rpy:2849
translate zh_cn start_26d9279d:

    # r "ほんともう……\nあいつは……"
    r "那家伙可真是的……"

# game/script.rpy:2851
translate zh_cn start_b4260cb9:

    # i "考えてみてくれたかい？　潤。"
    i "你考虑好了吗？　润。"

# game/script.rpy:2853
translate zh_cn start_966f00ad:

    # r "……え…………"
    r "……这个…………"

# game/script.rpy:2855
translate zh_cn start_c66b58a5:

    # r "……………"
    r "……………"

# game/script.rpy:2857
translate zh_cn start_1ec00fb2:

    # "唇を噛み、ためらいの表情へと\n沈みかけた潤は、思い切って\n五樹に顔の正面を向けた。"
    "润咬着嘴唇，\n低下头犹豫一阵后，\n又下定决心看向五树。"

# game/script.rpy:2859
translate zh_cn start_71c29fba:

    # r "先輩、私やっぱり\n行けないよ。"
    r "前辈，果然还是算了吧。"

# game/script.rpy:2861
translate zh_cn start_0386dc64_11:

    # i "…………"
    i "…………"

# game/script.rpy:2863
translate zh_cn start_545e86f7:

    # r "ママを放っておけない。"
    r "我不能放着妈妈不管。"

# game/script.rpy:2865
translate zh_cn start_3279415a:

    # "少女の瞳をみつめたまま、\n五樹はちいさく頷く。"
    "看到少女的双瞳依旧凝视着自己，\n五树轻轻地点了点头。"

# game/script.rpy:2867
translate zh_cn start_3656241b:

    # r "それにやっぱり、ズルしないで、\n自分でなんとかしなきゃって\n思うから。"
    r "而且果然还是不想走捷径，\n觉得必须自己想办法。"

# game/script.rpy:2869
translate zh_cn start_1b1d9203:

    # r "…………だから……"
    r "…………所以……"

# game/script.rpy:2871
translate zh_cn start_97745c0a:

    # r "……あのとき、貰ったヘッドホンを、\n先輩だと思って、頑張りますよ。"
    r "……我会把那个时候收到的耳机当作前辈的替身，\n继续努力的。"

# game/script.rpy:2873
translate zh_cn start_61201772:

    # i "……そっか……"
    i "……这样啊……"

# game/script.rpy:2875
translate zh_cn start_bdf27c6e:

    # i "……きみ、やっぱり\nしっかりしてるな。\n僕なんかより、ずっと。"
    i "润果然可靠啊，比我这种人可靠多了。"

# game/script.rpy:2877
translate zh_cn start_cb76ca5e:

    # r "……え……いや……"
    r "啊……没有这种事……"

# game/script.rpy:2879
translate zh_cn start_08e49fc2:

    # i "……でもとりあえず、\n勉強する時は、\n静かにやった方がいいよ。"
    i "不过，就目前而言，\n作为学生还是应该再安分点为好。"

# game/script.rpy:2881
translate zh_cn start_0dc62f96:

    # r "あははは。\n先輩ナイスツッコミ。"
    r "啊哈哈哈，前辈你别说笑。"

# game/script.rpy:2883
translate zh_cn start_84b87245:

    # r "な、何言ってんだろーな、\nあたしは。"
    r "真是的，我在说什么啊。"

# game/script.rpy:2885
translate zh_cn start_9a65391a:

    # "潤と五樹の微笑みに、\n汽笛の音がかぶさってきた。"
    "汽笛高鸣，\n盖过了两人的谈笑"

# game/script.rpy:2900
translate zh_cn start_530295a1:

    # j "あーあ、行っちゃった？"
    j "啊～啊，哥哥已经走啦？"

# game/script.rpy:2902
translate zh_cn start_dc311820:

    # r "樹里………"
    r "树里……"

# game/script.rpy:2904
translate zh_cn start_acbd8ddf:

    # r "何してたんだよ。\nたったいま、発車したとこ\nだったのに。"
    r "你怎么现在才来？火车已经发车了。"

# game/script.rpy:2908
translate zh_cn start_53555ae6:

    # j "あちゃー。"
    j "哎呀——"

# game/script.rpy:2912
translate zh_cn start_0ee707ea:

    # r "…………もう……"
    r "唉…………"

# game/script.rpy:2914
translate zh_cn start_7ae3dffe:

    # r "あんたは……マイペースっつーか、\n先が思いやられるっつーか……"
    r "该说你是我行我素，\n还是神经大条好呢……"

# game/script.rpy:2916
translate zh_cn start_7ebe5e6f:

    # r "しっかりしてくれなきゃ、\n先輩だって、安心して向こうで\nやってけないじゃないか。"
    r "你不好好振作起来的话，\n前辈在那边也会担心啊。"

# game/script.rpy:2921
translate zh_cn start_b2038b14_3:

    # j "…………"
    j "…………"

# game/script.rpy:2923
translate zh_cn start_747666c9:

    # r "………………っ……"
    r "…………啊……"

# game/script.rpy:2925
translate zh_cn start_f42af9b9:

    # r "……ごめん。\nきつく言い過ぎた。"
    r "………抱歉，我说得太过了。"

# game/script.rpy:2927
translate zh_cn start_a82ee870:

    # r "べつに、\n姉貴ヅラするつもりじゃ……"
    r "我并没有装作姐姐对你说教的意思……"

# game/script.rpy:2931
translate zh_cn start_56eb4429:

    # j "……ううん。へいき。"
    j "没事啦……我不介意的。"

# game/script.rpy:2933
translate zh_cn start_0b65ecef:

    # j "潤ちゃんこそ\n目、あかいよ。"
    j "反而是润酱的眼眶湿润了哦。"

# game/script.rpy:2935
translate zh_cn start_4232d017:

    # r "……え……"
    r "欸…………？"

# game/script.rpy:2937
translate zh_cn start_95a9fdbf:

    # r "あ……\nこれはさ……"
    r "啊，这是……"

# game/script.rpy:2939
translate zh_cn start_282f98c9:

    # j "さては　　　　　　　　　　　\n目にホコリが入ったんでしょ？"
    j "好吧　　　　　　　　　　　\n就当是眼里进沙子了吧。"

# game/script.rpy:2944
translate zh_cn start_3fd48aa6:

    # r "…………こい…つは～…………"
    r "啊……是…………"

# game/script.rpy:2949
translate zh_cn start_7a1d6692:

    # j "そーゆーわけだから\nかき氷、食べ行こっか。\n潤ちゃん。"
    j "所以，我们去吃刨冰吧，润酱。"

# game/script.rpy:2951
translate zh_cn start_437a9122:

    # r "……またいきなり。"
    r "……又突然这样。"

# game/script.rpy:2953
translate zh_cn start_3b2730ce:

    # r "行きたいなら\nひとりで───"
    r "想去的话你就自己——"

# game/script.rpy:2957z
translate zh_cn start_6636a9f4:

    # j "じゃあ、\nひんやりぷるぷる\nわらび餅。"
    j "那就，去吃冰凉Ｑ弹的蕨饼。"

# game/script.rpy:2959
translate zh_cn start_1dc13613:

    # r "観光地料金で\n飲み食いなんかしない。"
    r "我又不是来这里旅游吃喝的。"

# game/script.rpy:2963
translate zh_cn start_da860d38:

    # j "いーじゃない、\nどうせ暇なんだから。"
    j "有什么关系，反正也是闲着。"

# game/script.rpy:2965
translate zh_cn start_0bb2b8f3:

    # r "暇じゃない！\nだからぁ、受験生だってのに。"
    r "才不闲！所以说，我可是考生啊。"

# game/script.rpy:2969
translate zh_cn start_c91573e2:

    # j "……潤ちゃんは、\nトゥルーなわらび餅を知らないから、\nそんなこと言えるんだ。"
    j "润酱是因为不知道蕨麻糬的美味，\n所以才会这么说的。"

# game/script.rpy:2971
translate zh_cn start_2fa67686:

    # r "子供か！"
    r "你是小屁孩吗！"

# game/script.rpy:2973
translate zh_cn start_02f56192:

    # r "……ったく……"
    r "……真是的……"

# game/script.rpy:2975
translate zh_cn start_fd6896bd:

    # r "……そんなの、粉さえあれば\nすぐできるっての。"
    r "……那种东西，只要有粉，马上就能做出来啦。"

# game/script.rpy:2977
translate zh_cn start_5edda60f:

    # r "戻ったら、\n作ったげるよ。"
    r "回去之后，我做给你吃。"

# game/script.rpy:2981
translate zh_cn start_b23bde51:

    # j "…………へえー……"
    j "…………嘿诶……"

# game/script.rpy:2985
translate zh_cn start_d85dd490:

    # j "潤ちゃん、優しいんだ。"
    j "润酱，真温柔啊。"

# game/script.rpy:2987
translate zh_cn start_6817ab62:

    # r "…か……っ……\nからかうなって…………"
    r "别……别开我玩笑了！"

# game/script.rpy:3000
translate zh_cn start_2455daf0:

    # "　　　　　………………"

    "　　　　　………………"

# game/script.rpy:3002
translate zh_cn start_543ab499:

    # "　……ありふれていることや、\n　なんでもない日々の繰り返しだって\n　大切に思える時がある。"
    "　……即便是平凡之事，\n　或是日复一日的寻常时光，\n　有时也会觉得格外珍贵。"

# game/script.rpy:3004
translate zh_cn start_8a4726fd:

    # "　誰も……ただ一瞬のためだけに、\n　　　生きているんじゃない。"
    "　没有谁……活在这个世上，\n　　　仅仅是为了一瞬的欢愉。"

# game/script.rpy:3006
translate zh_cn start_76fbf305:

    # "　　　……どうでもいいわ。\n　　　そんなこと。"
    "　　　这样的事情……\n　　　怎么样都好啦。"

# game/script.rpy:3008
translate zh_cn start_76ebe059:

    # "　　　　　……樹里……"
    "　　　　　……树里……"

# game/script.rpy:3014
translate zh_cn start_f1ad3e08:

    # "　　　　　　樹里……　　　　　　　　　　"
    "　　　　　　树里……　　　　　　　　　　"

# game/script.rpy:3016
translate zh_cn start_e25ebf8c:

    # "　　僕らも……変わっていくんだ。"
    "　　我们也会……改变的啊。"

# game/script.rpy:3018
translate zh_cn start_7a7bfb7d:

    # "　　　　もう……一緒には、\n　　　　いられないんだ……"
    "　　　　总会……没办法\n　　　　继续在一起……"

# game/script.rpy:3020
translate zh_cn start_ef134459:

    # "　　　いられるわ、ずっと。"
    "　　　可以的，可以维持这份永恒的。"

# game/script.rpy:3022
translate zh_cn start_da52f197:

    # "　　兄さんはいつだって……"
    "　　因为哥哥一直都是……"

# game/script.rpy:3024
translate zh_cn start_290ae4ab:

    # "　　かえってきてくれるもの……"
    "　　渴望并终将归省的人啊……"


